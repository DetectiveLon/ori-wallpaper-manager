<Window x:Class="Ori.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Ori" Height="640" Width="1240" MinHeight="600" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        WindowStyle="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One rail template for every entry in MainViewModel.Items. The button
             Tag feeds the shared NavButtonStyle selection trigger; the marker is
             driven by the same comparison so the accent bar cannot disagree with
             the row's tint. AccessText renders the "_" in AccessLabel as an
             Alt+letter mnemonic (D/L/P/A/S) and underlines it on demand. -->
        <DataTemplate x:Key="NavItemTemplate">
            <Grid SnapsToDevicePixels="True">
                <Border x:Name="SelectionMarker" Tag="{Binding Key}"
                        Width="3" Margin="0,8,0,8" HorizontalAlignment="Left"
                        VerticalAlignment="Stretch" CornerRadius="0,2,2,0"
                        Background="{StaticResource AccentBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource NavKeyMatchConverter}">
                                            <Binding Path="DataContext.SelectedItem.Key"
                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Button Margin="3,0,0,0" Style="{StaticResource NavButtonStyle}"
                        Tag="{Binding Key}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Key}"
                        AutomationProperties.Name="{Binding Label}"
                        AutomationProperties.HelpText="{Binding ToolTip}"
                        ToolTip="{Binding ToolTip}"
                        KeyboardNavigation.TabIndex="{Binding TabIndex}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                   FontSize="{StaticResource GlyphSize}" Width="22" TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <AccessText Text="{Binding AccessLabel}" Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: app mark + drag region + caption buttons. -->
        <Border Grid.Row="0"
                Background="{StaticResource TitleBarBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="O" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource OnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ORI" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="WALLPAPER STUDIO" Style="{StaticResource CaptionTextStyle}"
                                   FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Empty middle column is the drag region. -->
                <Grid Grid.Column="1" Background="Transparent" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch"
                            HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" AutomationProperties.Name="Minimize" ToolTip="Minimize (Alt+M)"
                            KeyboardNavigation.TabIndex="0"
                            Style="{StaticResource WindowButtonStyle}" Click="OnMinimizeClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons"
                                   FontSize="{StaticResource WindowGlyphSize}"
                                   Foreground="{StaticResource WindowButtonForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="MaximizeButton" AutomationProperties.Name="Maximize" ToolTip="Maximize / Restore (Alt+R)"
                            KeyboardNavigation.TabIndex="1"
                            Style="{StaticResource WindowButtonStyle}" Click="OnMaximizeClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   FontSize="{StaticResource WindowGlyphSize}"
                                   Foreground="{StaticResource WindowButtonForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button x:Name="CloseButton" AutomationProperties.Name="Close" ToolTip="Close (Alt+C)"
                            KeyboardNavigation.TabIndex="2"
                            Style="{StaticResource CloseWindowButtonStyle}" Click="OnCloseClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons"
                                   FontSize="{StaticResource WindowGlyphSize}"
                                   Foreground="{StaticResource WindowButtonForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: navigation rail + page host. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True" Margin="0,18,0,16">
                    <!-- Identity/status replaces the old "ORI · LOCAL" caption: a
                         quiet reminder that everything stays on this machine. -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource ChipStyle}"
                            Margin="16,8,16,0" Padding="10,6"
                            ToolTip="Wallpapers are saved and rotated on this PC">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="LOCAL · ON THIS PC" Style="{StaticResource CaptionTextStyle}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource DividerBrush}"
                            Margin="20,4,20,14" />

                    <!-- The rail is generated from MainViewModel.Items. Grouping by
                         the item's Section keeps headers and items from drifting. -->
                    <ItemsControl Margin="12,0,12,0"
                                  ItemTemplate="{StaticResource NavItemTemplate}">
                        <ItemsControl.Resources>
                            <CollectionViewSource x:Key="NavGroups" Source="{Binding Items}">
                                <CollectionViewSource.GroupDescriptions>
                                    <PropertyGroupDescription PropertyName="Section" />
                                </CollectionViewSource.GroupDescriptions>
                            </CollectionViewSource>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemsSource>
                            <Binding Source="{StaticResource NavGroups}" />
                        </ItemsControl.ItemsSource>
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource EyebrowTextStyle}"
                                                   Margin="14,16,0,8" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="{StaticResource ContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Eyebrow -> title -> subtitle. Spacing follows the shared 8pt
                     scale (8/16/24) so the header reads as one hierarchy. -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="{Binding Section}" Style="{StaticResource EyebrowTextStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="PageTitle" Text="{Binding Title}" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock x:Name="PageSubtitle" Text="{Binding Subtitle}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                </StackPanel>

                <!-- No host ScrollViewer: every page owns its own vertical scrolling.
                     A second one here would either double the scrollbars or make
                     the page's inner scroll viewer stop working. -->
                <ContentControl x:Name="PageBody" Grid.Row="1" Content="{Binding CurrentView}" Margin="0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
