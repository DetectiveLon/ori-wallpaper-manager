<UserControl x:Class="Ori.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="960">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- No view-level outer margin: the first card starts flush with the
             shell content edge. Cards are separated by the 24px section step. -->
        <StackPanel>

            <!-- Wallhaven: the single owner of the API key on this machine. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Wallhaven" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="Optional. Stored encrypted for this Windows user and used only for Wallhaven requests that need it (for example NSFW results). Search works without a key for SFW content." />

                    <TextBlock Text="Wallhaven API key" Style="{StaticResource FieldLabelStyle}"
                               Margin="0,16,0,0" />
                    <PasswordBox x:Name="ApiKeyBox" PasswordChar="•" Width="360" MaxWidth="520"
                                 MinHeight="32" HorizontalAlignment="Left" Padding="8,4,8,4"
                                 AutomationProperties.Name="Wallhaven API key"
                                 ToolTip="Paste a Wallhaven API key. It is stored encrypted for this Windows user."
                                 KeyboardNavigation.TabIndex="8" />

                    <StackPanel Style="{StaticResource CardActionRowStyle}">
                        <Button Content="Save API key" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveApiKeyCommand}"
                                ToolTip="Encrypt and save the API key for this Windows user"
                                AutomationProperties.Name="Save Wallhaven API key"
                                KeyboardNavigation.TabIndex="9" />
                        <Button Content="Remove key" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding RemoveApiKeyCommand}" Margin="8,0,0,0"
                                ToolTip="Delete the stored API key from this Windows user profile"
                                AutomationProperties.Name="Remove stored API key"
                                KeyboardNavigation.TabIndex="10" />
                    </StackPanel>
                    <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Startup: the toggle's label is the single state signal. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Startup" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="Register Ori for the current Windows user so it starts quietly when you sign in. No administrator rights needed." />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start Ori when I sign in:" Style="{StaticResource BodyTextStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{Binding StartupToggleLabel}"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ToggleStartupCommand}"
                                ToolTip="Enable or disable launching Ori when you sign in"
                                AutomationProperties.Name="{Binding StartupToggleLabel}"
                                KeyboardNavigation.TabIndex="15" />
                    </Grid>
                    <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <CheckBox Content="Start minimized to tray" Margin="0,16,0,0"
                              IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                              Command="{Binding ToggleStartMinimizedCommand}"
                              AutomationProperties.Name="{Binding StartMinimizedAutomationName}"
                              ToolTip="When on, Ori starts with only its tray icon visible; click the icon to open it"
                              KeyboardNavigation.TabIndex="21" />
                    <TextBlock Text="{Binding StartMinimizedStatus}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" Margin="4,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Local files: routine maintenance is low emphasis, so every
                 action here is a ghost button. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Local files" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="Thumbnails and full-size downloads are cached to avoid repeat downloads. Clearing the cache never removes wallpapers you saved to your library." />

                    <StackPanel Style="{StaticResource CardActionRowStyle}" Margin="0,16,0,0">
                        <Button Content="Clear cached images" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ClearCacheCommand}"
                                ToolTip="Delete downloaded thumbnails and full-size images from the cache; your library is not affected"
                                AutomationProperties.Name="Clear cached images"
                                KeyboardNavigation.TabIndex="11" />
                        <Button Content="Repair library paths" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding RepairLibraryPathsCommand}" Margin="8,0,0,0"
                                ToolTip="Repair library entries that still point at the old data folder after a move"
                                AutomationProperties.Name="Repair library paths"
                                KeyboardNavigation.TabIndex="20" />
                        <Button Content="Clear orphan wallpaper files" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ClearOrphansCommand}" Margin="8,0,0,0"
                                ToolTip="Delete applied wallpaper files that are no longer referenced by your library; asks for confirmation first"
                                AutomationProperties.Name="Clear orphan wallpaper files"
                                KeyboardNavigation.TabIndex="12" />
                    </StackPanel>
                    <TextBlock Text="{Binding CacheStatus}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <!-- Inline confirmation is its own surface: one primary Confirm,
                         one ghost Cancel. Nothing is deleted until Confirm. -->
                    <Border Style="{StaticResource PanelStyle}" Margin="0,12,0,0"
                            Visibility="{Binding IsClearOrphansConfirmationOpen,
                                         Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ClearOrphansConfirmationText}"
                                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            <StackPanel Style="{StaticResource CardActionRowStyle}" Margin="0,8,0,0">
                                <Button Content="Confirm clear" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ConfirmClearOrphansCommand}" IsDefault="True"
                                        KeyboardNavigation.TabIndex="13"
                                        ToolTip="Permanently delete the orphan wallpaper files"
                                        AutomationProperties.Name="Confirm clear orphan wallpaper files" />
                                <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding CancelClearOrphansCommand}" Margin="8,0,0,0"
                                        IsCancel="True" KeyboardNavigation.TabIndex="14"
                                        ToolTip="Keep the orphan wallpaper files and close this confirmation"
                                        AutomationProperties.Name="Cancel clear orphan wallpaper files" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- About & data: where the files live, what version is running, and
                 navigation-like actions kept as ghosts. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="About &amp; data" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="Ori keeps its data under your Windows user profile. Nothing is uploaded." />

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="{Binding LibraryPathText}" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SchedulesPathText}" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding LogPathText}" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding VersionInfo}" Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock Margin="0,12,0,0">
                        <Run Text="&#xE71B;   " FontFamily="Segoe Fluent Icons"
                             Foreground="{StaticResource AccentBrush}" />
                        <Hyperlink NavigateUri="{Binding GitHubUrl}" RequestNavigate="OnRequestNavigate"
                                   AutomationProperties.Name="View the source on GitHub"
                                   KeyboardNavigation.TabIndex="19">
                            <Run Text="View the source on GitHub" />
                        </Hyperlink>
                    </TextBlock>

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTip="Open the Ori data folder in File Explorer"
                                AutomationProperties.Name="Open data folder"
                                KeyboardNavigation.TabIndex="16" />
                        <Button Content="View error log" Command="{Binding ViewErrorLogCommand}"
                                Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"
                                ToolTip="Open the error log in your default text editor"
                                AutomationProperties.Name="View error log"
                                KeyboardNavigation.TabIndex="17" />
                        <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}"
                                Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"
                                ToolTip="Copy a redacted diagnostics summary to the clipboard"
                                AutomationProperties.Name="Copy diagnostics"
                                KeyboardNavigation.TabIndex="18" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- The page's single bottom status line; no extra card wrapper. -->
            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
