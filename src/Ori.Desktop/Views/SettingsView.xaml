<UserControl x:Class="Ori.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="960">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Only wraps text; colour and size come from the shared CaptionTextStyle. -->
        <Style x:Key="WrappedCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,8">

            <!-- Intro. The shell already supplies the page title and subtitle. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="A few things worth tuning." Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Style="{StaticResource WrappedCaption}" MaxWidth="720" Margin="0,8,0,0"
                               Text="Keys, cache and startup live on this machine only. Nothing here is uploaded." />
                </StackPanel>
            </Border>

            <!-- Wallhaven -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Wallhaven" Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource WrappedCaption}" MaxWidth="720"
                               Text="Optional. Stored encrypted for this Windows user and used only for Wallhaven requests that need it (for example NSFW results). Search works without a key for SFW content." />
                    <PasswordBox x:Name="ApiKeyBox" PasswordChar="•" Height="36" MaxWidth="520"
                                 HorizontalAlignment="Left" Padding="10,6,10,6" Margin="0,16,0,0"
                                 AutomationProperties.Name="Wallhaven API key"
                                 ToolTip="Paste a Wallhaven API key. It is stored encrypted for this Windows user." />
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="Remove key"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RemoveApiKeyCommand}" Padding="14,8,14,8" Margin="8,0,0,0"
                                ToolTip="Delete the stored API key from this Windows user profile"
                                AutomationProperties.Name="Remove stored API key"
                                KeyboardNavigation.TabIndex="10" />
                        <Button Content="Save API key" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveApiKeyCommand}" Padding="18,8,18,8"
                                HorizontalAlignment="Left"
                                ToolTip="Encrypt and save the API key for this Windows user"
                                AutomationProperties.Name="Save Wallhaven API key"
                                KeyboardNavigation.TabIndex="9" />
                    </DockPanel>
                    <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource WrappedCaption}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Local files -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Local files" Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource WrappedCaption}" MaxWidth="720"
                               Text="Thumbnails and full-size downloads are cached to avoid repeat downloads. Clearing the cache never removes wallpapers you saved to your library." />
                    <Button Content="Clear cached images" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ClearCacheCommand}" Padding="14,8,14,8"
                            HorizontalAlignment="Left" Margin="0,16,0,0"
                            ToolTip="Delete downloaded thumbnails and full-size images from the cache; your library is not affected"
                            AutomationProperties.Name="Clear cached images"
                            KeyboardNavigation.TabIndex="11" />
                    <TextBlock Text="{Binding CacheStatus}" Style="{StaticResource WrappedCaption}" Margin="0,10,0,0" />
                    <Button Content="Clear orphan wallpaper files" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearOrphansCommand}" Padding="14,8,14,8"
                            HorizontalAlignment="Left" Margin="0,12,0,0"
                            ToolTip="Delete applied wallpaper files that are no longer referenced by your library; asks for confirmation first"
                            AutomationProperties.Name="Clear orphan wallpaper files"
                            KeyboardNavigation.TabIndex="12" />
                    <Border Background="{StaticResource PanelAltBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}" Padding="12"
                            BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsClearOrphansConfirmationOpen,
                                         Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ClearOrphansConfirmationText}"
                                       Style="{StaticResource WrappedCaption}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Confirm clear" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ConfirmClearOrphansCommand}" Padding="14,8,14,8"
                                        IsDefault="True" KeyboardNavigation.TabIndex="13"
                                        ToolTip="Permanently delete the orphan wallpaper files"
                                        AutomationProperties.Name="Confirm clear orphan wallpaper files" />
                                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CancelClearOrphansCommand}" Padding="14,8,14,8"
                                        Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="14"
                                        ToolTip="Keep the orphan wallpaper files and close this confirmation"
                                        AutomationProperties.Name="Cancel clear orphan wallpaper files" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Startup: the text is the state signal; colour and chip only reinforce it. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Startup" Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource WrappedCaption}" MaxWidth="720"
                               Text="Register Ori for the current Windows user so it starts quietly when you sign in. No administrator rights needed." />
                    <DockPanel Margin="0,16,0,0">
                        <Button DockPanel.Dock="Right" Content="{Binding StartupToggleLabel}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="14,8,14,8" Margin="8,0,0,0"
                                Command="{Binding ToggleStartupCommand}"
                                ToolTip="Enable or disable launching Ori when you sign in"
                                AutomationProperties.Name="{Binding StartupToggleLabel}"
                                KeyboardNavigation.TabIndex="15" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Start Ori when I sign in:" Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Style="{StaticResource ChipStyle}"
                                    AutomationProperties.Name="{Binding StartupAutomationName}">
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                            <Setter Property="Text" Value="Off" />
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StartupEnabled}" Value="True">
                                                    <Setter Property="Text" Value="On" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource WrappedCaption}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- About & data -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="About &amp; data" Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource WrappedCaption}" MaxWidth="720"
                               Text="Ori keeps its data under your Windows user profile. Nothing is uploaded." />
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding LibraryPathText}" Style="{StaticResource WrappedCaption}" />
                        <TextBlock Text="{Binding SchedulesPathText}" Style="{StaticResource WrappedCaption}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding LogPathText}" Style="{StaticResource WrappedCaption}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding VersionInfo}" Style="{StaticResource WrappedCaption}" Margin="0,7,0,0" />
                    </StackPanel>
                    <TextBlock Margin="0,14,0,0" FontSize="12">
                        <Run Text="&#xE71B;   " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             Foreground="{StaticResource AccentBrush}" />
                        <Hyperlink NavigateUri="{Binding GitHubUrl}" RequestNavigate="OnRequestNavigate"
                                   AutomationProperties.Name="View the source on GitHub"
                                   KeyboardNavigation.TabIndex="19">
                            <Run Text="View the source on GitHub" />
                        </Hyperlink>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"
                                Padding="14,8,14,8"
                                ToolTip="Open the Ori data folder in File Explorer"
                                AutomationProperties.Name="Open data folder"
                                KeyboardNavigation.TabIndex="16" />
                        <Button Content="View error log" Command="{Binding ViewErrorLogCommand}"
                                Padding="14,8,14,8" Margin="8,0,0,0"
                                ToolTip="Open the error log in your default text editor"
                                AutomationProperties.Name="View error log"
                                KeyboardNavigation.TabIndex="17" />
                        <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}"
                                Padding="14,8,14,8" Margin="8,0,0,0"
                                ToolTip="Copy a redacted diagnostics summary to the clipboard"
                                AutomationProperties.Name="Copy diagnostics"
                                KeyboardNavigation.TabIndex="18" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Latest status message -->
            <Border Style="{StaticResource CardStyle}">
                <TextBlock Text="{Binding Status}" Style="{StaticResource WrappedCaption}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
