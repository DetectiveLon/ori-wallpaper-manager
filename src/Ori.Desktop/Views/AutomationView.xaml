<UserControl x:Class="Ori.Desktop.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Ori.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="960"
             Background="{StaticResource WindowBrush}">
    <UserControl.Resources>
        <!-- The app-wide SecondaryButtonStyle / PrimaryButtonStyle already carry
             self-contained dark templates with a dimmed (never white) disabled
             state. Only sizing is added here; no local template pair is needed. -->
        <Style x:Key="CardActionButton" TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="CardPrimaryActionButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- The shell renders the page eyebrow/title/subtitle, so the first card is
             the top of this scroll content. -->
        <StackPanel Margin="0,0,0,24">

            <!-- Global controls: one master switch for every display, plus Wallhaven opt-in. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20" Padding="18">
                <StackPanel>
                    <TextBlock Text="Global controls" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Text="These settings apply across all displays. Each display can still opt out of full-screen pausing on its own card." />
                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="MASTER SWITCH" Style="{StaticResource FieldLabelStyle}" />
                            <CheckBox Content="Pause rotation while a full-screen app is active"
                                      IsChecked="{Binding PauseWhenFullscreen, Mode=TwoWay}"
                                      FontSize="13" MinHeight="36"
                                      ToolTip="Master switch: rotation pauses only on displays that also have their own full-screen pause enabled."
                                      AutomationProperties.Name="Master switch: pause rotation while a full-screen app is active" />
                            <TextBlock Text="LIBRARY" Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,14,0,0" />
                            <CheckBox Content="Enable automatic Wallhaven fetching"
                                      IsChecked="{Binding AutoFetchFromWallhaven, Mode=TwoWay}"
                                      FontSize="13" MinHeight="36"
                                      ToolTip="Off by default. Only enabled feeds fetch, each on its own cadence."
                                      AutomationProperties.Name="Enable automatic Wallhaven fetching" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh monitors"
                                Style="{StaticResource CardActionButton}"
                                MinWidth="132" VerticalAlignment="Top"
                                Command="{Binding RefreshDisplaysCommand}"
                                ToolTip="Re-detect connected monitors and restore saved schedules for any monitor that appears."
                                AutomationProperties.Name="Refresh monitors" />
                    </Grid>

                    <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                               Margin="0,14,0,0"
                               Text="Full-screen detection is based on the foreground window covering a display. The master switch and each feed's own enable box must both be on before anything is fetched." />
                </StackPanel>
            </Border>

            <!-- Multi-feed management. Sits between global controls and schedules so
                 the source of new images is configured before their rotation. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20" Padding="18">
                <StackPanel>
                    <TextBlock Text="Wallhaven rotation feeds" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Text="The master toggle above must be on, and each feed has its own enable box. Every feed fetches on its own cadence. New images are applied on the next rotation, or immediately with Fetch now." />
                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,14" />

                    <ItemsControl ItemsSource="{Binding Feeds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAltBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0" MinWidth="180">
                                                <TextBlock Text="FEED NAME" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         FontSize="13" Height="36"
                                                         ToolTip="Rename this feed. The name is saved when the field loses focus."
                                                         AutomationProperties.Name="Rotation feed name" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,14,0" MinWidth="132">
                                                <TextBlock Text="FETCH EVERY" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox ItemsSource="{Binding CadenceOptions}"
                                                          SelectedItem="{Binding CadenceMinutes, Mode=TwoWay}"
                                                          FontSize="13" Height="40" MinWidth="132"
                                                          ToolTip="How often this feed checks Wallhaven for new images."
                                                          AutomationProperties.Name="Feed fetch cadence" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" MinWidth="96">
                                                <TextBlock Text="STATE" Style="{StaticResource FieldLabelStyle}" />
                                                <CheckBox Content="Enabled"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          FontSize="13" MinHeight="40"
                                                          ToolTip="Turn this feed on or off without deleting it."
                                                          AutomationProperties.Name="Feed enabled" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding StatusText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,10,0,0" />

                                        <!-- Filters are editable here: the draft is committed only by
                                             Save filters, which validates through the feed store. -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0" MinWidth="180">
                                                <TextBlock Text="SEARCH QUERY" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13" Height="36"
                                                         ToolTip="Wallhaven search expression for this feed (at most 300 characters). Saved with Save filters."
                                                         AutomationProperties.Name="Feed search query" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Save filters"
                                                    Style="{StaticResource CardActionButton}"
                                                    VerticalAlignment="Bottom"
                                                    Command="{Binding SaveFiltersCommand}"
                                                    ToolTip="Validate and save this feed's filters. Cadence, enabled state, fetch history and feed order stay unchanged."
                                                    AutomationProperties.Name="Save this feed's filters" />
                                        </Grid>

                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Fetch now" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding FetchNowCommand}"
                                                    IsEnabled="{Binding CanFetchNow}"
                                                    ToolTip="Requires the global Wallhaven toggle. Fetch this feed now, regardless of its cadence, and apply the first new image."
                                                    AutomationProperties.Name="Fetch this feed now" />
                                            <Button Content="Move up" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding MoveUpCommand}"
                                                    ToolTip="Move this feed earlier in the sweep order."
                                                    AutomationProperties.Name="Move feed up" />
                                            <Button Content="Move down" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding MoveDownCommand}"
                                                    ToolTip="Move this feed later in the sweep order."
                                                    AutomationProperties.Name="Move feed down" />
                                            <Button Content="Remove" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="Remove this feed. Saved wallpapers stay in your library."
                                                    AutomationProperties.Name="Remove feed" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Add from Discover" Style="{StaticResource CardPrimaryActionButton}"
                            HorizontalAlignment="Left" Margin="0,4,0,0"
                            Command="{Binding AddFeedFromDiscoverCommand}"
                            ToolTip="Open Discover, search Wallhaven and save a search as a rotation feed."
                            AutomationProperties.Name="Add a rotation feed from Discover" />
                </StackPanel>
            </Border>

            <TextBlock Text="Display schedules" Style="{StaticResource SectionTitleStyle}"
                       Margin="2,0,0,12" />

            <!-- One card per connected display. -->
            <ItemsControl ItemsSource="{Binding Schedules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>

                                <!-- Display identity + explicit state pill. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{Binding Subheading}" Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource ChipStyle}"
                                            HorizontalAlignment="Right" MinWidth="96" Margin="12,0,0,0">
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="RUNNING" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Paused}">
                                                            <Setter Property="Text" Value="PAUSED" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Idle}">
                                                            <Setter Property="Text" Value="IDLE" />
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Preparing}">
                                                            <Setter Property="Text" Value="STARTING" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Applying}">
                                                            <Setter Property="Text" Value="APPLYING" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Compact countdown panel: glyph + label + live text. -->
                                <Border Background="{StaticResource PanelAltBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="14,12" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="20" Width="26" Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="&#xE768;" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Paused}">
                                                            <Setter Property="Text" Value="&#xE769;" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Idle}">
                                                            <Setter Property="Text" Value="&#xE71A;" />
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Preparing}">
                                                            <Setter Property="Text" Value="&#xE895;" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Applying}">
                                                            <Setter Property="Text" Value="&#xE895;" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="NEXT CHANGE" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding Countdown}" FontSize="20" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RotationState}"
                                                                         Value="{x:Static vm:RotationState.Paused}">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RotationState}"
                                                                         Value="{x:Static vm:RotationState.Idle}">
                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyTextStyle}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" />

                                <!-- Per-display opt-out, clearly subordinate to the master above. -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="THIS DISPLAY" Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <CheckBox Content="Pause rotation for full-screen apps"
                                              IsChecked="{Binding PauseWhenFullscreen, Mode=TwoWay}"
                                              FontSize="13" MinHeight="36"
                                              ToolTip="Per-display opt-out: this display pauses only when the global master switch is also on."
                                              AutomationProperties.Name="Pause rotation for full-screen apps on this display" />
                                </StackPanel>

                                <!-- Consistent interval picker + labelled action deck. -->
                                <Border Background="{StaticResource PanelAltBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="14" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" MinWidth="184">
                                            <TextBlock Text="CHANGE EVERY" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding Intervals}"
                                                      SelectedItem="{Binding SelectedInterval, Mode=TwoWay}"
                                                      IsEnabled="{Binding IntervalEnabled}"
                                                      FontSize="13" Height="40" MinWidth="184"
                                                      ToolTip="How often Ori chooses a new wallpaper for this display."
                                                      AutomationProperties.Name="Rotation interval for this display" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="1" Margin="0,2,16,2"
                                                Background="{StaticResource DividerBrush}" />
                                        <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="Start" Style="{StaticResource CardPrimaryActionButton}"
                                                    Command="{Binding StartCommand}"
                                                    IsEnabled="{Binding CanStart}"
                                                    ToolTip="Start rotating wallpapers on this display using your local library or an enabled feed."
                                                    AutomationProperties.Name="Start rotation on this display" />
                                            <Button Content="{Binding PauseButtonText}" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding PauseCommand}"
                                                    IsEnabled="{Binding CanPause}"
                                                    ToolTip="Pause this schedule without losing its deadline, or resume a paused schedule."
                                                    AutomationProperties.Name="Pause or resume rotation on this display" />
                                            <Button Content="Previous" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding PreviousCommand}"
                                                    IsEnabled="{Binding CanUsePrevious}"
                                                    ToolTip="Re-apply the previous wallpaper on this display and restart the interval. Enabled once a wallpaper has been replaced here."
                                                    AutomationProperties.Name="Restore the previous wallpaper on this display" />
                                            <Button Content="Rotate now" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding RotateNowCommand}"
                                                    IsEnabled="{Binding CanRotateNow}"
                                                    ToolTip="Apply a new local wallpaper now and restart the interval."
                                                    AutomationProperties.Name="Rotate the wallpaper now on this display" />
                                            <Button Content="Stop" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding StopCommand}"
                                                    IsEnabled="{Binding CanStop}"
                                                    ToolTip="Stop this display's schedule and clear its saved schedule."
                                                    AutomationProperties.Name="Stop rotation on this display" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Library / feed / display availability and refresh diagnostics. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0" Padding="14,12">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding GlobalStatus}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
