<UserControl x:Class="Ori.Desktop.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Ori.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="960"
             Background="{StaticResource WindowBrush}">
    <UserControl.Resources>
        <!-- Card action buttons are self-contained. They must not inherit a theme
             style: the Windows disabled template is what painted the Pause and
             Stop actions white. Every brush below is an explicit dark palette
             resource, and being disabled only dims opacity. -->
        <ControlTemplate x:Key="CardSecondaryButtonTemplate" TargetType="Button">
            <Border x:Name="Surface"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{StaticResource TextBrush}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Surface" Property="Opacity" Value="0.42" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="CardActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource CardSecondaryButtonTemplate}" />
        </Style>

        <ControlTemplate x:Key="CardPrimaryButtonTemplate" TargetType="Button">
            <Border x:Name="Surface"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{StaticResource OnAccentBrush}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Surface" Property="Opacity" Value="0.42" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="CardPrimaryActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource CardPrimaryButtonTemplate}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- The shell already renders the page eyebrow/title/subtitle. Starting the
             scroll content at the global controls card keeps that card wholly
             visible at scroll offset zero instead of hidden behind a second,
             redundant title block. -->
        <StackPanel Margin="0,0,0,24">

            <!-- Global controls: one master switch for every display, plus Wallhaven opt-in. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20" Padding="18">
                <StackPanel>
                    <TextBlock Text="Global controls" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="These settings apply across all displays. Each display can still opt out of full-screen pausing on its own card." />
                    <Border Height="1" Background="{StaticResource DividerBrush}"
                            Margin="0,14,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="MASTER SWITCH" Style="{StaticResource FieldLabelStyle}"
                                       FontSize="12" Margin="0,0,0,4" />
                            <CheckBox Content="Pause rotation while a full-screen app is active"
                                      IsChecked="{Binding PauseWhenFullscreen, Mode=TwoWay}"
                                      FontSize="13" MinHeight="36"
                                      ToolTip="Master switch: rotation pauses only on displays that also have their own full-screen pause enabled."
                                      AutomationProperties.Name="Master switch: pause rotation while a full-screen app is active" />
                            <TextBlock Text="LIBRARY" Style="{StaticResource FieldLabelStyle}"
                                       FontSize="12" Margin="0,12,0,4" />
                            <CheckBox Content="Auto-fetch from Wallhaven using current Discover filters"
                                      IsChecked="{Binding AutoFetchFromWallhaven, Mode=TwoWay}"
                                      FontSize="13" MinHeight="36"
                                      ToolTip="Off by default. Fetches new wallpapers only when a display has no unseen local wallpapers left."
                                      AutomationProperties.Name="Auto-fetch from Wallhaven using current Discover filters" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh displays"
                                Style="{StaticResource CardActionButton}"
                                MinWidth="132" VerticalAlignment="Top"
                                Command="{Binding RefreshDisplaysCommand}"
                                ToolTip="Re-detect connected displays and restore saved schedules for any display that appears."
                                AutomationProperties.Name="Refresh connected displays" />
                    </Grid>

                    <TextBlock Style="{StaticResource CaptionTextStyle}" FontSize="12"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Full-screen detection is based on the foreground window covering a display. Auto-fetch uses whatever filters you last searched with in Discover." />
                </StackPanel>
            </Border>

            <TextBlock Text="Display schedules" Style="{StaticResource SectionTitleStyle}"
                       Margin="2,0,0,12" />

            <!-- One card per connected display. -->
            <ItemsControl ItemsSource="{Binding Schedules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>

                                <!-- Display identity + explicit state pill. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{Binding Subheading}" Style="{StaticResource CaptionTextStyle}"
                                                   FontSize="12" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource ChipStyle}"
                                            HorizontalAlignment="Right" MinWidth="96" Margin="12,0,0,0">
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="RUNNING" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Paused}">
                                                            <Setter Property="Text" Value="PAUSED" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Idle}">
                                                            <Setter Property="Text" Value="IDLE" />
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Preparing}">
                                                            <Setter Property="Text" Value="STARTING" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Applying}">
                                                            <Setter Property="Text" Value="APPLYING" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Compact countdown panel: glyph + label + live text. -->
                                <Border Background="{StaticResource PanelAltBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="14,12" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="20" Width="26" Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="&#xE768;" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Paused}">
                                                            <Setter Property="Text" Value="&#xE769;" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Idle}">
                                                            <Setter Property="Text" Value="&#xE71A;" />
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Preparing}">
                                                            <Setter Property="Text" Value="&#xE895;" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RotationState}"
                                                                     Value="{x:Static vm:RotationState.Applying}">
                                                            <Setter Property="Text" Value="&#xE895;" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="NEXT CHANGE" Style="{StaticResource FieldLabelStyle}"
                                                       FontSize="12" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding Countdown}" FontSize="20" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RotationState}"
                                                                         Value="{x:Static vm:RotationState.Paused}">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RotationState}"
                                                                         Value="{x:Static vm:RotationState.Idle}">
                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyTextStyle}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" />

                                <!-- Per-display opt-out, clearly subordinate to the master above. -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="THIS DISPLAY" Style="{StaticResource FieldLabelStyle}"
                                               FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <CheckBox Content="Pause rotation for full-screen apps"
                                              IsChecked="{Binding PauseWhenFullscreen, Mode=TwoWay}"
                                              FontSize="13" MinHeight="36"
                                              ToolTip="Per-display opt-out: this display pauses only when the global master switch is also on."
                                              AutomationProperties.Name="Pause rotation for full-screen apps on this display" />
                                </StackPanel>

                                <!-- Consistent interval picker + labelled action deck. -->
                                <Border Background="{StaticResource PanelAltBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="14" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" MinWidth="184">
                                            <TextBlock Text="CHANGE EVERY" Style="{StaticResource FieldLabelStyle}"
                                                       FontSize="12" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding Intervals}"
                                                      SelectedItem="{Binding SelectedInterval, Mode=TwoWay}"
                                                      IsEnabled="{Binding IntervalEnabled}"
                                                      FontSize="13" Height="40" MinWidth="184"
                                                      ToolTip="How often Ori chooses a new wallpaper for this display."
                                                      AutomationProperties.Name="Rotation interval for this display" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="1" Margin="0,2,16,2"
                                                Background="{StaticResource DividerBrush}" />
                                        <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="Start" Style="{StaticResource CardPrimaryActionButton}"
                                                    Command="{Binding StartCommand}"
                                                    IsEnabled="{Binding CanStart}"
                                                    ToolTip="Start rotating wallpapers on this display using your local library."
                                                    AutomationProperties.Name="Start rotation on this display" />
                                            <Button Content="{Binding PauseButtonText}" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding PauseCommand}"
                                                    IsEnabled="{Binding CanPause}"
                                                    ToolTip="Pause this schedule without losing its deadline, or resume a paused schedule."
                                                    AutomationProperties.Name="Pause or resume rotation on this display" />
                                            <Button Content="Previous" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding PreviousCommand}"
                                                    IsEnabled="{Binding CanRotateNow}"
                                                    ToolTip="Re-apply the previous wallpaper on this display and restart the interval."
                                                    AutomationProperties.Name="Restore the previous wallpaper on this display" />
                                            <Button Content="Rotate now" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding RotateNowCommand}"
                                                    IsEnabled="{Binding CanRotateNow}"
                                                    ToolTip="Apply a new local wallpaper now and restart the interval."
                                                    AutomationProperties.Name="Rotate the wallpaper now on this display" />
                                            <Button Content="Stop" Style="{StaticResource CardActionButton}"
                                                    Command="{Binding StopCommand}"
                                                    IsEnabled="{Binding CanStop}"
                                                    ToolTip="Stop this display's schedule and clear its saved schedule."
                                                    AutomationProperties.Name="Stop rotation on this display" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Library / display availability and refresh diagnostics. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0" Padding="14,12">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding GlobalStatus}" Style="{StaticResource CaptionTextStyle}"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
