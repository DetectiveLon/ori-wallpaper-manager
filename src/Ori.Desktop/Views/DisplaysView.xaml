<UserControl x:Class="Ori.Desktop.Views.DisplaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{StaticResource WindowBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Hero: per-monitor control. -->
            <Border Background="#202D3D" CornerRadius="18" Padding="22" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel MaxWidth="620" VerticalAlignment="Center">
                        <TextBlock Text="PER-MONITOR CONTROL" Style="{StaticResource Kicker}" />
                        <TextBlock Text="Give every display its own wallpaper."
                                   FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Ori targets each connected monitor independently. Pick an image per screen; Windows supplies the shared fit mode."
                                   FontSize="12" Foreground="#B7C6D8" TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="18,0,0,0">
                        <Border Width="72" Height="56" CornerRadius="10" Background="#31445B">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="36"
                                       Foreground="#B7D1EE" />
                        </Border>
                        <Button Command="{Binding RefreshCommand}" Padding="12,9"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="Refresh" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inline status. -->
            <Border Background="#18212C" CornerRadius="10" Padding="12,10" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="13"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding Status}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Monitors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="16"
                                Padding="20" Margin="0,0,0,14"
                                BorderBrush="#2D3C50" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Device glyph. -->
                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="13"
                                        Background="#26384E" Margin="0,0,16,0">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}"
                                               FontSize="30" Foreground="{StaticResource AccentBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DeviceName}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="16" FontWeight="SemiBold" />
                                        <Border Background="{StaticResource AccentBrush}"
                                                CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="PRIMARY" Foreground="#101722"
                                                       FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ResolutionText}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,6,0,0" />
                                    <Border Margin="0,10,18,0" Padding="9,7" CornerRadius="8"
                                            Background="#18212C">
                                        <StackPanel>
                                            <TextBlock Text="CURRENT WALLPAPER"
                                                       Style="{StaticResource Kicker}" FontSize="9" />
                                            <TextBlock Text="{Binding WallpaperText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Prominent per-display action. -->
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,10,16,10" Margin="18,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#101722" Background="{StaticResource AccentBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        Command="{Binding DataContext.ChooseImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B9;" Style="{StaticResource Glyph}"
                                                   FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Choose image" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
