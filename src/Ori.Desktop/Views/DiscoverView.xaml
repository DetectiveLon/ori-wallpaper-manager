<UserControl x:Class="Ori.Desktop.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="276" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Filter rail: one header, collapsible sections, one sticky commit. -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                Margin="0,0,24,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Filters" Style="{StaticResource SectionTitleStyle}"
                           Margin="20,20,20,16" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,16">
                    <StackPanel>
                        <!-- TAGS -->
                        <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="True"
                                  Expanded="OnSectionExpanded" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="TAGS" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Keywords" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox MinHeight="32"
                                         Text="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Example: landscape, nature, -people"
                                         AutomationProperties.Name="Search tags" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="Separate tags with commas. Prefix with - to exclude; + to require." />
                            </StackPanel>
                        </Expander>

                        <!-- CATEGORIES -->
                        <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="True"
                                  Expanded="OnSectionExpanded" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="CATEGORIES" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <WrapPanel>
                                <ToggleButton Content="General" Padding="12,8" MinHeight="32"
                                              Margin="0,0,4,4"
                                              AutomationProperties.Name="General category"
                                              ToolTip="Include general wallpapers"
                                              IsChecked="{Binding General, Mode=TwoWay}" />
                                <ToggleButton Content="Anime" Padding="12,8" MinHeight="32"
                                              Margin="0,0,4,4"
                                              AutomationProperties.Name="Anime category"
                                              ToolTip="Include anime wallpapers"
                                              IsChecked="{Binding Anime, Mode=TwoWay}" />
                                <ToggleButton Content="People" Padding="12,8" MinHeight="32"
                                              Margin="0,0,4,4"
                                              AutomationProperties.Name="People category"
                                              ToolTip="Include photos of people"
                                              IsChecked="{Binding People, Mode=TwoWay}" />
                            </WrapPanel>
                        </Expander>

                        <!-- CONTENT -->
                        <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="False"
                                  Expanded="OnSectionExpanded" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="CONTENT" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel>
                                <WrapPanel>
                                    <ToggleButton Content="SFW" Padding="12,8" MinHeight="32"
                                                  Margin="0,0,4,4"
                                                  AutomationProperties.Name="Safe for work content"
                                                  ToolTip="Include safe-for-work results"
                                                  IsChecked="{Binding Safe, Mode=TwoWay}" />
                                    <ToggleButton Content="Sketchy" Padding="12,8" MinHeight="32"
                                                  Margin="0,0,4,4"
                                                  AutomationProperties.Name="Sketchy content"
                                                  ToolTip="Include sketchy results"
                                                  IsChecked="{Binding Sketchy, Mode=TwoWay}" />
                                    <ToggleButton Content="NSFW" Padding="12,8" MinHeight="32"
                                                  Margin="0,0,4,4"
                                                  AutomationProperties.Name="NSFW content"
                                                  ToolTip="Include NSFW results (requires an API key)"
                                                  IsChecked="{Binding Explicit, Mode=TwoWay}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Text="NSFW results require your Wallhaven API key." />
                            </StackPanel>
                        </Expander>

                        <!-- QUICK TAGS -->
                        <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="False"
                                  Expanded="OnSectionExpanded" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="QUICK TAGS" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding TagPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Margin="0,0,4,4"
                                                    AutomationProperties.Name="{Binding Label, StringFormat='Apply preset: {0}'}"
                                                    ToolTip="{Binding Tags}"
                                                    Command="{Binding DataContext.ApplyPresetCommand,
                                                        RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding RecentTags}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentTags.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Margin="0,0,4,4"
                                                    AutomationProperties.Name="{Binding StringFormat='Apply recent tag: {0}'}"
                                                    ToolTip="Apply this recently used tag query"
                                                    Command="{Binding DataContext.ApplyTagCommand,
                                                        RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- SORTING (the API key now lives only in Settings) -->
                        <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="False"
                                  Expanded="OnSectionExpanded" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="SORTING" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Sort by" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox MinHeight="32" DisplayMemberPath="Label"
                                          ItemsSource="{Binding SortingChoices}"
                                          SelectedItem="{Binding SelectedSorting, Mode=TwoWay}"
                                          AutomationProperties.Name="Sort results by"
                                          ToolTip="Choose how search results are ordered" />
                                <TextBlock Text="Toplist period" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox MinHeight="32" DisplayMemberPath="Label"
                                          ItemsSource="{Binding TopRangeChoices}"
                                          SelectedItem="{Binding SelectedTopRange, Mode=TwoWay}"
                                          IsEnabled="{Binding IsTopRangeEnabled}"
                                          ToolTip="{Binding TopRangeToolTip}"
                                          AutomationProperties.Name="Toplist period"
                                          AutomationProperties.HelpText="{Binding TopRangeToolTip}" />
                                <TextBlock Text="Order" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox MinHeight="32" DisplayMemberPath="Label"
                                          ItemsSource="{Binding OrderChoices}"
                                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                          AutomationProperties.Name="Sort direction"
                                          ToolTip="Ascending or descending order" />

                                <TextBlock Style="{StaticResource StatusTextStyle}"
                                           Text="NSFW needs a Wallhaven API key. It is saved in Settings and used for searches in this visit only." />
                                <Button Content="Open Settings" Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding OpenSettingsCommand}"
                                        AutomationProperties.Name="Open Settings to manage the API key"
                                        ToolTip="Save or remove your Wallhaven API key in Settings" />
                            </StackPanel>
                        </Expander>

                        <!-- RESOLUTION -->
                        <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="False"
                                  Expanded="OnSectionExpanded" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="RESOLUTION" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Minimum resolution" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox MinHeight="32"
                                         Text="{Binding MinimumResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="1920x1080"
                                         AutomationProperties.Name="Minimum resolution" />
                                <TextBlock Text="Exact resolution" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox MinHeight="32"
                                         Text="{Binding ExactResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="3840x2160"
                                         AutomationProperties.Name="Exact resolution" />
                                <TextBlock Text="Aspect ratio" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox MinHeight="32" DisplayMemberPath="Label"
                                          ItemsSource="{Binding RatioChoices}"
                                          SelectedItem="{Binding SelectedRatio, Mode=TwoWay}"
                                          AutomationProperties.Name="Aspect ratio"
                                          ToolTip="Filter by screen aspect ratio" />
                            </StackPanel>
                        </Expander>

                        <!-- COLOUR -->
                        <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="False"
                                  Expanded="OnSectionExpanded" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="COLOUR" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Palette colours" Style="{StaticResource FieldLabelStyle}" />
                                <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding ColorChoices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Padding="8,8" MinHeight="32" Margin="0,0,4,4"
                                                              ToolTip="{Binding ToolTip}"
                                                              AutomationProperties.Name="{Binding ToolTip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="14" Height="14"
                                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                                Background="{Binding SwatchBrush}"
                                                                BorderBrush="{StaticResource ControlBorderBrush}"
                                                                BorderThickness="1" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding Hex}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="Custom hex values" Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,8,0,4" />
                                <TextBox MinHeight="32"
                                         Text="{Binding CustomColors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Custom hex colors, comma-separated"
                                         AutomationProperties.Name="Custom hex colours" />
                            </StackPanel>
                        </Expander>

                        <!-- ROTATION FEED: authoring only; Auto rotation manages saved feeds. -->
                        <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="False"
                                  Expanded="OnSectionExpanded">
                            <Expander.Header>
                                <TextBlock Text="ROTATION FEED" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Feed name" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox MinHeight="32"
                                         Text="{Binding FeedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Leave blank to use your tags or an automatic name"
                                         AutomationProperties.Name="Rotation feed name" />
                                <TextBlock Text="Fetch every" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox MinHeight="32"
                                          ItemsSource="{Binding FeedCadenceChoices}"
                                          SelectedItem="{Binding SelectedFeedCadence, Mode=TwoWay}"
                                          AutomationProperties.Name="Rotation feed cadence"
                                          ToolTip="Minutes between automatic fetches (15..10080)" />
                                <TextBlock Text="Custom minutes (15..10080)" Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,8,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" MinHeight="32" Margin="0,0,8,0"
                                             Text="{Binding CustomFeedCadenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Any whole number of minutes from 15 to 10080"
                                             AutomationProperties.Name="Custom rotation feed cadence in minutes" />
                                    <Button Grid.Column="1" Content="Use" Style="{StaticResource GhostButtonStyle}"
                                            VerticalAlignment="Top"
                                            Command="{Binding ApplyCustomFeedCadenceCommand}"
                                            AutomationProperties.Name="Apply custom rotation feed cadence"
                                            ToolTip="Set the cadence to this many minutes" />
                                </Grid>
                                <TextBlock Text="Items per fetch" Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,8,0,4" />
                                <TextBox MinHeight="32"
                                         Text="{Binding FeedMaximumItemsPerFetch, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="How many images one fetch may take from this feed (1..10)"
                                         AutomationProperties.Name="Items per fetch for this feed" />
                                <Button Content="Save as rotation feed" Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding SaveAsFeedCommand}"
                                        AutomationProperties.Name="Save current filters as rotation feed"
                                        ToolTip="Save the current filters as a named feed for automatic rotation" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Text="Saved feeds are managed in Auto rotation: enable, rename, reorder, edit filters, set cadence and remove them there." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- The single page-level commit, pinned below the scrolling filters. -->
                <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0" Padding="20,16">
                    <Button Content="Search wallpapers" Style="{StaticResource PrimaryButtonStyle}"
                            MinHeight="40" HorizontalAlignment="Stretch"
                            Command="{Binding SearchCommand}"
                            AutomationProperties.Name="Search wallpapers"
                            ToolTip="Search Wallhaven with the current filters" />
                </Border>
            </Grid>
        </Border>

        <!-- Results column -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Apply-to line: one label, one 172px target picker, one ghost action. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Apply to" Style="{StaticResource FieldLabelStyle}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="172" MinHeight="32" DisplayMemberPath="DeviceName"
                          ItemsSource="{Binding Monitors}"
                          SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                          AutomationProperties.Name="Target display for Apply"
                          ToolTip="Choose which display receives the applied wallpaper" />
                <Button Content="Apply selected" Style="{StaticResource GhostButtonStyle}"
                        Margin="8,0,0,0"
                        Command="{Binding ApplySelectedCommand}"
                        AutomationProperties.Name="Apply the selected wallpaper"
                        ToolTip="Apply the highlighted wallpaper to the target display" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Wallpaper search results"
                         ToolTip="Select a wallpaper, then use its actions">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardSelection" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="2"
                                                CornerRadius="{StaticResource CardCornerRadius}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardSelection" Property="BorderBrush"
                                                        Value="{StaticResource SubtleBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardSelection" Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="296" Background="{StaticResource PanelBrush}"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="14" Margin="0,0,12,12"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <Border Height="148" Background="{StaticResource PanelAltBrush}"
                                            CornerRadius="{StaticResource ControlCornerRadius}" ClipToBounds="True">
                                        <Image Stretch="UniformToFill" HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" Source="{Binding Thumbnail}" />
                                    </Border>
                                    <TextBlock Text="{Binding Resolution}" Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold" Margin="0,12,0,4" />
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <!-- One secondary commit, then three ghost actions. -->
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Apply this wallpaper to the target display"
                                            ToolTip="Download and apply this wallpaper to the selected display">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="Apply to display" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.35*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="0.85*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource GhostButtonStyle}"
                                                Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Open wallhaven page"
                                                ToolTip="Open this wallpaper's page on Wallhaven">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}"
                                                           Margin="0,0,4,0" />
                                                <TextBlock Text="Open page" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                                                Margin="4,0,4,0"
                                                Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Preview wallpaper"
                                                ToolTip="Open a full-size preview of this wallpaper">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7B3;" Style="{StaticResource Glyph}"
                                                           Margin="0,0,4,0" />
                                                <TextBlock Text="Preview" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}"
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Save wallpaper to library"
                                                ToolTip="Save this wallpaper to your local library">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}"
                                                           Margin="0,0,4,0" />
                                                <TextBlock Text="Save" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty and busy states are mutually exclusive and never intercept input. -->
                <Border IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border Style="{StaticResource EmptyStatePanelStyle}">
                        <StackPanel>
                            <Border Width="108" Height="108" CornerRadius="54"
                                    Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="54"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource TitleTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,16,0,8" />
                            <TextBlock Text="{Binding EmptyStateMessage}" Style="{StaticResource StatusTextStyle}"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Border>

                <Border IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border Style="{StaticResource PanelStyle}" Width="260"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <ProgressBar Height="6" IsIndeterminate="True" />
                            <TextBlock Text="Working…" Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- One bottom status line: text-led, with a single accent dot. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock Text="●" Foreground="{StaticResource AccentBrush}" FontSize="10"
                           Margin="0,8,8,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" />
            </StackPanel>

            <!-- Pager -->
            <Border Grid.Row="3" Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" Content="Previous" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8" Command="{Binding PreviousCommand}"
                            AutomationProperties.Name="Previous results page"
                            ToolTip="Go to the previous page of results" />
                    <Button DockPanel.Dock="Right" Content="Next" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8" Command="{Binding NextCommand}"
                            AutomationProperties.Name="Next results page"
                            ToolTip="Go to the next page of results" />
                    <TextBlock Text="{Binding PageText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
