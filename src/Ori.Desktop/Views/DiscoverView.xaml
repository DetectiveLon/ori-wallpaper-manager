<UserControl x:Class="Ori.Desktop.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">
    <UserControl.Resources>
        <!-- Local styles only add layout on top of the app-wide type scale and brushes.
             The type scale's 10/11px sizes are too small on this dense page, so the
             text helpers below raise them to a 12px floor without hardcoding colours. -->
        <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style x:Key="DiscoverEyebrow" TargetType="TextBlock" BasedOn="{StaticResource EyebrowTextStyle}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="DiscoverCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="DiscoverFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Filter chips: the shared ToggleButton template supplies the themed
             hover/checked/pressed states; this only makes the targets easier to hit. -->
        <Style x:Key="FilterChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="FontSize" Value="{StaticResource BodySize}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="ColorChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <!-- Quiet preset/recent-tag actions. All their colours come from SecondaryButtonStyle. -->
        <Style x:Key="TagButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <!-- The primary rail action inherits AccentBrush and its hover/pressed states
             from PrimaryButtonStyle; no local hardcoded colours. -->
        <Style x:Key="SearchButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="16,10" />
        </Style>

        <!-- Secondary actions on each result card: icon + label, at least 32px tall.
             No Background setter here: SecondaryButtonStyle owns the dark template. -->
        <Style x:Key="CardSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <!-- Collapsible rail sections share the app's dark Expander template. Only
             spacing is local; header text uses SectionTitleStyle for a bold 15px label. -->
        <Style x:Key="FilterSection" TargetType="Expander" BasedOn="{StaticResource SectionExpanderStyle}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <!-- Expanding a section near the bottom pushes its content below the
                 fold. Bring it back into view so the click always shows a result. -->
            <EventSetter Event="Expanded" Handler="OnSectionExpanded" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="276" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Filter rail: collapsible groups, with the primary action pinned below them. -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" CornerRadius="14"
                Margin="0,0,14,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,15,16,13">
                    <TextBlock Text="SEARCH WALLHAVEN" Style="{StaticResource DiscoverEyebrow}" />
                    <TextBlock Text="Find your wallpaper" Style="{StaticResource SectionTitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="16,2,16,14">
                    <StackPanel>
                        <!-- TAGS: the most common section, open by default. -->
                        <Expander Style="{StaticResource FilterSection}" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock Text="TAGS" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel Margin="2,2,0,4">
                                <TextBlock Text="Keywords" Style="{StaticResource DiscoverFieldLabel}" />
                                <TextBox Style="{StaticResource FieldTextBox}"
                                         Text="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Example: landscape, nature, -people"
                                         AutomationProperties.Name="Search tags" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="Separate tags with commas. Prefix with - to exclude; + to require." />
                            </StackPanel>
                        </Expander>

                        <!-- QUICK TAGS: presets + recently used queries. -->
                        <Expander Style="{StaticResource FilterSection}" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="QUICK TAGS" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel Margin="2,2,0,4">
                                <ItemsControl ItemsSource="{Binding TagPresets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Style="{StaticResource TagButton}"
                                                    AutomationProperties.Name="{Binding Label, StringFormat='Apply preset: {0}'}"
                                                    ToolTip="{Binding Tags}"
                                                    Command="{Binding DataContext.ApplyPresetCommand,
                                                        RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding RecentTags}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentTags.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Style="{StaticResource TagButton}"
                                                    AutomationProperties.Name="{Binding StringFormat='Apply recent tag: {0}'}"
                                                    ToolTip="Apply this recently used tag query"
                                                    Command="{Binding DataContext.ApplyTagCommand,
                                                        RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- ROTATION FEEDS: author a named feed from the current filters,
                             then manage the saved feeds without leaving Discover. -->
                        <Expander Style="{StaticResource FilterSection}" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="ROTATION FEEDS" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel Margin="2,2,0,4">
                                <TextBlock Text="Feed name" Style="{StaticResource DiscoverFieldLabel}" />
                                <TextBox Style="{StaticResource FieldTextBox}"
                                         Text="{Binding FeedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Leave blank to use your tags or an automatic name"
                                         AutomationProperties.Name="Rotation feed name" />
                                <TextBlock Text="Fetch every" Style="{StaticResource DiscoverFieldLabel}" />
                                <ComboBox Style="{StaticResource FieldCombo}"
                                          ItemsSource="{Binding FeedCadenceChoices}"
                                          SelectedItem="{Binding SelectedFeedCadence, Mode=TwoWay}"
                                          AutomationProperties.Name="Rotation feed cadence"
                                          ToolTip="Minutes between automatic fetches" />
                                <Button Content="Save as rotation feed" Style="{StaticResource SearchButton}"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding SaveAsFeedCommand}"
                                        AutomationProperties.Name="Save current filters as rotation feed"
                                        ToolTip="Save the current filters as a named feed for automatic rotation" />
                                <!-- Feed rows cache their status text, so make re-reading
                                     the store an explicit action instead of leaving
                                     "Paused until..." stale for the whole visit. -->
                                <Button Content="Refresh feeds" Style="{StaticResource TagButton}"
                                        Command="{Binding RefreshFeedsCommand}"
                                        AutomationProperties.Name="Refresh rotation feeds"
                                        ToolTip="Re-read saved feeds and refresh their status" />

                                <ItemsControl ItemsSource="{Binding Feeds}" Margin="0,10,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Feeds.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" CornerRadius="8"
                                                    Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding CadenceMinutes, StringFormat='Every {0} min'}"
                                                               Style="{StaticResource DiscoverCaption}" />
                                                    <TextBlock Text="{Binding IsEnabled, StringFormat='Enabled: {0}'}"
                                                               Style="{StaticResource DiscoverCaption}" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Style="{StaticResource DiscoverCaption}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Button Content="Enable/Disable" Style="{StaticResource TagButton}"
                                                                Command="{Binding Parent.ToggleFeedEnabledCommand}"
                                                                CommandParameter="{Binding Id}"
                                                                AutomationProperties.Name="Toggle rotation feed enabled state"
                                                                ToolTip="Enable or disable this rotation feed" />
                                                        <Button Content="Remove" Style="{StaticResource TagButton}"
                                                                Command="{Binding Parent.RemoveFeedCommand}"
                                                                CommandParameter="{Binding Id}"
                                                                AutomationProperties.Name="Remove rotation feed"
                                                                ToolTip="Delete this rotation feed" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- CATEGORIES: open by default alongside TAGS. -->
                        <Expander Style="{StaticResource FilterSection}" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock Text="CATEGORIES" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <WrapPanel Margin="2,2,0,4">
                                <ToggleButton Style="{StaticResource FilterChip}" Content="General"
                                              AutomationProperties.Name="General category"
                                              ToolTip="Include general wallpapers"
                                              IsChecked="{Binding General, Mode=TwoWay}" />
                                <ToggleButton Style="{StaticResource FilterChip}" Content="Anime"
                                              AutomationProperties.Name="Anime category"
                                              ToolTip="Include anime wallpapers"
                                              IsChecked="{Binding Anime, Mode=TwoWay}" />
                                <ToggleButton Style="{StaticResource FilterChip}" Content="People"
                                              AutomationProperties.Name="People category"
                                              ToolTip="Include photos of people"
                                              IsChecked="{Binding People, Mode=TwoWay}" />
                            </WrapPanel>
                        </Expander>

                        <!-- CONTENT -->
                        <Expander Style="{StaticResource FilterSection}" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="CONTENT" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel Margin="2,2,0,4">
                                <WrapPanel>
                                    <ToggleButton Style="{StaticResource FilterChip}" Content="SFW"
                                                  AutomationProperties.Name="Safe for work content"
                                                  ToolTip="Include safe-for-work results"
                                                  IsChecked="{Binding Safe, Mode=TwoWay}" />
                                    <ToggleButton Style="{StaticResource FilterChip}" Content="Sketchy"
                                                  AutomationProperties.Name="Sketchy content"
                                                  ToolTip="Include sketchy results"
                                                  IsChecked="{Binding Sketchy, Mode=TwoWay}" />
                                    <ToggleButton Style="{StaticResource FilterChip}" Content="NSFW"
                                                  AutomationProperties.Name="NSFW content"
                                                  ToolTip="Include NSFW results (requires an API key)"
                                                  IsChecked="{Binding Explicit, Mode=TwoWay}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="NSFW results require your Wallhaven API key." />
                            </StackPanel>
                        </Expander>

                        <!-- WALLHAVEN: advanced, collapsed by default. -->
                        <Expander Style="{StaticResource FilterSection}" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="WALLHAVEN" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel Margin="2,2,0,4">
                                <TextBlock Text="API key" Style="{StaticResource DiscoverFieldLabel}" />
                                <PasswordBox x:Name="ApiKeyBox" MinHeight="34" Margin="0,0,0,6" Padding="9,5"
                                             AutomationProperties.Name="Wallhaven API key"
                                             ToolTip="Used for searches in this visit and sent only to Wallhaven. Nothing is saved until you press Save key." />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="Not saved automatically. Save it here or in Settings so NSFW results stay available on later visits and in rotation." />
                                <Button Content="Save key" Style="{StaticResource TagButton}"
                                        Command="{Binding SaveApiKeyCommand}"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Save API key locally"
                                        ToolTip="Explicitly save this key (DPAPI-protected); Settings can also save or remove it" />
                                <TextBlock Text="Sorting" Style="{StaticResource DiscoverFieldLabel}" />
                                <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                          ItemsSource="{Binding SortingChoices}"
                                          SelectedItem="{Binding SelectedSorting, Mode=TwoWay}"
                                          AutomationProperties.Name="Sort results by"
                                          ToolTip="Choose how search results are ordered" />
                                <TextBlock Text="Toplist period" Style="{StaticResource DiscoverFieldLabel}" />
                                <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                          ItemsSource="{Binding TopRangeChoices}"
                                          SelectedItem="{Binding SelectedTopRange, Mode=TwoWay}"
                                          IsEnabled="{Binding IsTopRangeEnabled}"
                                          ToolTip="{Binding TopRangeToolTip}"
                                          AutomationProperties.Name="Toplist period"
                                          AutomationProperties.HelpText="{Binding TopRangeToolTip}" />
                                <TextBlock Text="Order" Style="{StaticResource DiscoverFieldLabel}" />
                                <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                          ItemsSource="{Binding OrderChoices}"
                                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                          AutomationProperties.Name="Sort direction"
                                          ToolTip="Ascending or descending order" />
                            </StackPanel>
                        </Expander>

                        <!-- RESOLUTION: advanced, collapsed by default. -->
                        <Expander Style="{StaticResource FilterSection}" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="RESOLUTION" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel Margin="2,2,0,4">
                                <TextBlock Text="Minimum resolution" Style="{StaticResource DiscoverFieldLabel}" />
                                <TextBox Style="{StaticResource FieldTextBox}"
                                         Text="{Binding MinimumResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="1920x1080"
                                         AutomationProperties.Name="Minimum resolution" />
                                <TextBlock Text="Exact resolution" Style="{StaticResource DiscoverFieldLabel}" />
                                <TextBox Style="{StaticResource FieldTextBox}"
                                         Text="{Binding ExactResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="3840x2160"
                                         AutomationProperties.Name="Exact resolution" />
                                <TextBlock Text="Aspect ratio" Style="{StaticResource DiscoverFieldLabel}" />
                                <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                          ItemsSource="{Binding RatioChoices}"
                                          SelectedItem="{Binding SelectedRatio, Mode=TwoWay}"
                                          AutomationProperties.Name="Aspect ratio"
                                          ToolTip="Filter by screen aspect ratio" />
                            </StackPanel>
                        </Expander>

                        <!-- COLOUR: advanced, collapsed by default. -->
                        <Expander Style="{StaticResource FilterSection}" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="COLOUR" Style="{StaticResource SectionTitleStyle}" />
                            </Expander.Header>
                            <StackPanel Margin="2,2,0,4">
                                <TextBlock Text="Palette colours" Style="{StaticResource DiscoverFieldLabel}" />
                                <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding ColorChoices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              ToolTip="{Binding ToolTip}"
                                                              AutomationProperties.Name="{Binding ToolTip}"
                                                              Style="{StaticResource ColorChip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="14" Height="14" CornerRadius="2"
                                                                Background="{Binding SwatchBrush}"
                                                                BorderBrush="{StaticResource ControlBorderBrush}"
                                                                BorderThickness="1" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Hex}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="Custom hex values" Style="{StaticResource DiscoverFieldLabel}"
                                           Margin="0,12,0,6" />
                                <TextBox Style="{StaticResource FieldTextBox}"
                                         Text="{Binding CustomColors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Custom hex colors, comma-separated"
                                         AutomationProperties.Name="Custom hex colours" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="An API key is only used for this visit until you save it here or in Settings. Saved keys are DPAPI-protected and sent only to Wallhaven." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sticky primary action, separated from the scrolling filters. -->
                <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0" Padding="16,13">
                    <Button Content="Search wallpapers" Style="{StaticResource SearchButton}"
                            Command="{Binding SearchCommand}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Search wallpapers"
                            ToolTip="Search Wallhaven with the current filters" />
                </Border>
            </Grid>
        </Border>

        <!-- Results column -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status + target display. Every colour comes from shared resources;
                 disabled buttons use the app-wide dark SecondaryButtonStyle template. -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" CornerRadius="12"
                    Padding="14,11" Margin="0,0,0,12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="18,0,0,0">
                        <Button Content="Apply selected" Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="32"
                                Command="{Binding ApplySelectedCommand}"
                                AutomationProperties.Name="Apply the selected wallpaper"
                                ToolTip="Apply the highlighted wallpaper to the target display" />
                        <TextBlock Text="Apply to" Style="{StaticResource DiscoverCaption}"
                                   Margin="18,0,8,0" VerticalAlignment="Center" />
                        <ComboBox Width="172" DisplayMemberPath="DeviceName"
                                  ItemsSource="{Binding Monitors}"
                                  SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                  AutomationProperties.Name="Target display for Apply"
                                  ToolTip="Choose which display receives the applied wallpaper" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <!-- The placeholder status is replaced by the real empty state below. -->
                                    <DataTrigger Binding="{Binding Status}" Value="Choose filters and search.">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource DiscoverCaption}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Wallpaper search results"
                         ToolTip="Select a wallpaper, then use its actions">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardSelection" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="2"
                                                CornerRadius="14">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardSelection" Property="BorderBrush"
                                                        Value="{StaticResource SubtleBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardSelection" Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Wider cards and a larger gutter keep the grid from feeling cramped. -->
                            <Border Width="296" Background="{StaticResource PanelBrush}"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="14" Margin="0,0,16,16"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <Border Height="148" Background="{StaticResource PanelAltBrush}"
                                            CornerRadius="8" ClipToBounds="True">
                                        <Image Stretch="UniformToFill" HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" Source="{Binding Thumbnail}" />
                                    </Border>
                                    <TextBlock Text="{Binding Resolution}" Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold" Margin="1,12,0,4" />
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource DiscoverCaption}"
                                               TextWrapping="Wrap" Margin="1,0,0,12" />

                                    <!-- Obvious primary action, then three quiet icon+label actions. -->
                                    <Button Style="{StaticResource PrimaryButtonStyle}" MinHeight="36"
                                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Apply this wallpaper to the target display"
                                            ToolTip="Download and apply this wallpaper to the selected display">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Apply to display" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Give the longest label the widest column so no text clips. -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.35*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="0.85*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource CardSecondaryButton}"
                                                Margin="0,0,3,0"
                                                Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Open wallhaven page"
                                                ToolTip="Open this wallpaper's page on Wallhaven">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Open page" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource CardSecondaryButton}"
                                                Margin="3,0,3,0"
                                                Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Preview wallpaper"
                                                ToolTip="Open a full-size preview of this wallpaper">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Preview" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource CardSecondaryButton}"
                                                Margin="3,0,0,0"
                                                Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Save wallpaper to library"
                                                ToolTip="Save this wallpaper to your local library">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Save" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Genuine empty state: large Fluent glyph, headline, one guidance line.
                     Never intercept input from the results list underneath. -->
                <Border Background="{StaticResource WindowBrush}" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- A running search is not an empty state: hide the placeholder. -->
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <Border Width="108" Height="108" CornerRadius="54"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="54" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource TitleTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,20,0,7" />
                        <TextBlock Text="{Binding EmptyStateMessage}"
                                   Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="380" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Indeterminate progress while a search (or load) is in flight. -->
                <Border Background="{StaticResource WindowBrush}" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="260">
                        <ProgressBar Height="6" IsIndeterminate="True" />
                        <TextBlock Text="Working…" Style="{StaticResource DiscoverCaption}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pager -->
            <Border Grid.Row="2" Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" Content="Previous" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8" Command="{Binding PreviousCommand}"
                            AutomationProperties.Name="Previous results page"
                            ToolTip="Go to the previous page of results" />
                    <Button DockPanel.Dock="Right" Content="Next" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8" Command="{Binding NextCommand}"
                            AutomationProperties.Name="Next results page"
                            ToolTip="Go to the next page of results" />
                    <TextBlock Text="{Binding PageText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Style="{StaticResource DiscoverCaption}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
