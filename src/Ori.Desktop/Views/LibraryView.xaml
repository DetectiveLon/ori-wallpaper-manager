<UserControl x:Class="Ori.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="960"
             Background="{StaticResource WindowBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Local styles only tighten layout; colours and type come from App.xaml. -->
        <Style x:Key="ToolbarLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CardMeta" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Inherits the self-contained SecondaryButtonStyle; no Background/Foreground
             override here, so disabled actions stay dark instead of turning white. -->
        <Style x:Key="CardActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <!-- Editable ComboBox: the app-level ComboBox template has no editable text box,
             so the move control gets a local template with the required PART_EditableTextBox
             and a toggle button. Typing a fresh name and pressing Move creates a collection. -->
        <Style x:Key="EditableComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             CaretBrush="{StaticResource AccentBrush}"
                                             FontSize="{TemplateBinding FontSize}"
                                             Padding="7,3,2,3" VerticalContentAlignment="Center"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" />
                                    <ToggleButton x:Name="PART_DropDownToggle" Grid.Column="1"
                                                  Background="Transparent" BorderThickness="0"
                                                  Focusable="False" Cursor="Hand" ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <Path Data="M 0 3 L 5 8 L 10 3" Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="1.5" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{StaticResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: search, collection filter, sort, favourites, import,
             duplicate scan, new collection, refresh and apply target. -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" CornerRadius="14"
                Padding="12,11" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="210" Height="34" Margin="0,0,12,4">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="32,5,10,5" FontSize="12"
                             AutomationProperties.Name="Search library"
                             ToolTip="Search saved wallpapers by title, id, collection or tag" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14"
                               Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"
                               HorizontalAlignment="Left" Margin="10,0,0,0" />
                </Grid>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,4">
                    <TextBlock Text="Tag" Style="{StaticResource ToolbarLabel}" Margin="0,0,8,0" />
                    <TextBox Width="120" Height="34" FontSize="12"
                             Text="{Binding TagFilterText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter library by tag"
                             ToolTip="Show wallpapers with this tag; separate several tags with commas to match any" />
                    <Button Command="{Binding ClearTagFilterCommand}" Padding="8,6,8,6" Margin="5,0,0,0"
                            MinHeight="34" VerticalAlignment="Center"
                            AutomationProperties.Name="Clear tag filter"
                            ToolTip="Remove the tag filter">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12"
                                       Margin="0,0,5,0" />
                            <TextBlock Text="Clear" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="Collection" Style="{StaticResource ToolbarLabel}" Margin="0,0,8,4" />
                <ComboBox Width="140" Height="34" Margin="0,0,12,4"
                          ItemsSource="{Binding CollectionFilters}"
                          SelectedItem="{Binding SelectedCollectionFilter}"
                          AutomationProperties.Name="Filter by collection"
                          ToolTip="Show wallpapers from one collection" />

                <TextBlock Text="Sort" Style="{StaticResource ToolbarLabel}" Margin="0,0,8,4" />
                <ComboBox Width="112" Height="34" Margin="0,0,12,4"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort}"
                          AutomationProperties.Name="Sort library"
                          ToolTip="Choose how saved wallpapers are ordered" />

                <CheckBox IsChecked="{Binding FavoritesOnly}" Margin="0,0,14,4"
                          VerticalAlignment="Center" Cursor="Hand"
                          AutomationProperties.Name="Favourites only"
                          ToolTip="Show only wallpapers marked as favourites">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="Favourites only" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </CheckBox>

                <Button Click="OnImportFolderClick" Padding="11,7,11,7" Margin="0,0,10,4"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Import folder"
                        ToolTip="Import all images from a folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="13"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="Import folder…" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding FindDuplicatesCommand}" Padding="11,7,11,7" Margin="0,0,10,4"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Find duplicate wallpapers"
                        ToolTip="Scan the index for duplicate wallpapers">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D5;" Style="{StaticResource Glyph}" FontSize="13"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="Find duplicates" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding RefreshCommand}" IsEnabled="{Binding IsRefreshEnabled}"
                        Padding="11,7,11,7" Margin="0,0,10,4" VerticalAlignment="Center"
                        AutomationProperties.Name="Refresh library"
                        ToolTip="Reload the library index">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13"
                                   Margin="0,0,7,0" />
                        <TextBlock Text="Refresh" FontSize="12" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="New collection" Style="{StaticResource ToolbarLabel}" Margin="0,0,6,0" />
                    <TextBox Width="120" Height="30" FontSize="12"
                             Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="New collection name"
                             ToolTip="Type a name and press Create. Selecting a wallpaper moves it in; with none selected the collection is created empty." />
                    <Button Command="{Binding CreateCollectionCommand}" Padding="8,6,8,6" Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Create collection"
                            ToolTip="Create the named collection, moving the selected wallpaper into it if one is selected">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="13"
                                       Margin="0,0,4,0" />
                            <TextBlock Text="Create" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,4">
                    <TextBlock Text="Apply to" Style="{StaticResource ToolbarLabel}" Margin="0,0,8,0" />
                    <ComboBox Width="150" Height="34"
                              ItemsSource="{Binding Displays}"
                              SelectedItem="{Binding SelectedDisplay}"
                              DisplayMemberPath="DeviceName"
                              AutomationProperties.Name="Target display for Set wallpaper"
                              ToolTip="Choose which display receives the applied wallpaper" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Inline import progress and duplicate results. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Border Style="{StaticResource CardStyle}" CornerRadius="9" Padding="11,8" Margin="0,0,0,8"
                    Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding ImportProgress}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" CornerRadius="9" Padding="11,9"
                    Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding DuplicateStatus}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Only redundant copies are listed: one wallpaper per group was kept as the original. Removing a row deletes its library entry only; the image file is kept."
                               Style="{StaticResource CardMeta}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding Duplicates}" Margin="0,8,0,0" MaxHeight="220">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource CardMeta}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Remove" Padding="8,5,8,5"
                                            Margin="8,0,0,0" MinHeight="32"
                                            ToolTip="Remove only this redundant library entry; the original and the image file are kept"
                                            AutomationProperties.Name="Remove duplicate entry"
                                            Command="{Binding DataContext.RemoveDuplicateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Inline status strip. -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" CornerRadius="9" Padding="11,8"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="13"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyTextStyle}"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Gallery grid + empty state overlay. -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The VM realizes at most one page (48 cards) at a time, so a WrapPanel keeps
                 memory bounded without a custom virtualizing panel. -->
            <ListBox x:Name="EntriesListBox"
                     Grid.Row="0"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     AutomationProperties.Name="Saved wallpapers"
                     ToolTip="Select a wallpaper to create a collection with it">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,16,16" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <!-- Lazy thumbnail decode: fire only for realized cards.
                             Loaded covers first realization; DataContextChanged covers recycled cards. -->
                        <EventSetter Event="Loaded" Handler="OnCardLoaded" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- A simple themed border replaces the old drop shadow. -->
                        <Border Width="288" CornerRadius="{StaticResource CardCornerRadius}" Padding="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- Thumbnail with a favourite badge overlay. -->
                                <Grid Height="128">
                                    <Border CornerRadius="8" ClipToBounds="True"
                                            Background="{StaticResource PanelAltBrush}">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}" CornerRadius="6"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,8,8,0"
                                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}"
                                                       FontSize="12" Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,0,5,0" />
                                            <TextBlock Text="Saved" Style="{StaticResource CardMeta}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"
                                           Margin="1,8,0,2" />
                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource CardMeta}"
                                           Margin="1,0,0,8" />

                                <!-- One compact meta strip for collection, favourite and palette. -->
                                <WrapPanel Margin="0,0,0,8">
                                    <Border Style="{StaticResource ChipStyle}" Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}"
                                                       FontSize="12" Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding SelectedCollection}"
                                                       Style="{StaticResource CardMeta}" MaxWidth="118" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}" Margin="0,0,6,4"
                                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}"
                                                       FontSize="12" Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,0,5,0" />
                                            <TextBlock Text="Favourite" Style="{StaticResource CardMeta}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Computed tags are read-only chips here; the editable
                                         tag box below is the place to change them. -->
                                    <ItemsControl ItemsSource="{Binding TagChips}" MaxWidth="250"
                                                  Margin="0,0,6,4" HorizontalAlignment="Left"
                                                  AutomationProperties.Name="Tags on this wallpaper"
                                                  ToolTip="{Binding TagsText}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTags}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipStyle}" Margin="0,0,4,2">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource CardMeta}"
                                                               MaxWidth="110" TextTrimming="CharacterEllipsis"
                                                               AutomationProperties.Name="{Binding StringFormat='Tag: {0}'}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                Visibility="{Binding HasColors, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Colours" Style="{StaticResource CardMeta}"
                                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <ItemsControl ItemsSource="{Binding ColorSwatches}"
                                                      ToolTip="{Binding ColorsText}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="14" Height="14" CornerRadius="3"
                                                            Background="{Binding}" Margin="0,0,4,0"
                                                            BorderBrush="{StaticResource ControlBorderBrush}"
                                                            BorderThickness="1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Primary action + three icon/label actions, all 32px+ tall. -->
                                <Button Style="{StaticResource PrimaryButtonStyle}" MinHeight="34"
                                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Set this wallpaper"
                                        ToolTip="Apply this wallpaper to the target display">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}"
                                                   FontSize="14" Margin="0,0,7,0" />
                                        <TextBlock Text="Set wallpaper" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <UniformGrid Columns="3" Rows="1" Margin="0,8,0,8">
                                    <Button Style="{StaticResource CardActionButton}" Margin="0,0,4,0"
                                            Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding FavoriteLabel, StringFormat='Toggle favourite: {0}'}"
                                            ToolTip="Toggle favourite for this wallpaper">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}"
                                                       FontSize="13" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding FavoriteLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}" Margin="4,0,4,0"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Open wallpaper in viewer"
                                            ToolTip="Open the saved image in your image viewer">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}"
                                                       FontSize="13" Margin="0,0,4,0" />
                                            <TextBlock Text="Open" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}" Margin="4,0,0,0"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Remove wallpaper from library"
                                            ToolTip="Open the removal confirmation; nothing is deleted until you confirm">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}"
                                                       FontSize="13" Margin="0,0,4,0" />
                                            <TextBlock Text="Remove" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <!-- Collection move row: editable so a typed name becomes a collection. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Height="32" FontSize="12"
                                              Style="{StaticResource EditableComboBox}"
                                              IsEditable="True"
                                              AutomationProperties.Name="Move to collection"
                                              ToolTip="Pick a collection or type a new name, then press Move"
                                              ItemsSource="{Binding DataContext.MoveTargets, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                              Text="{Binding SelectedCollection, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,5,8,5"
                                            MinHeight="32" FontSize="12"
                                            AutomationProperties.Name="Move to selected collection"
                                            ToolTip="Move to selected collection"
                                            Command="{Binding DataContext.MoveToCollectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8DE;" Style="{StaticResource Glyph}"
                                                       FontSize="13" Margin="0,0,4,0" />
                                            <TextBlock Text="Move" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Tags row: labelled input with an in-place watermark. The
                                     hint collapses as soon as TagText has a value, so the box
                                     never reads as an empty, unlabelled rectangle. -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Add tags"
                                               Style="{StaticResource FieldLabelStyle}" FontSize="12" />
                                    <Grid Grid.Row="1" Grid.Column="0">
                                        <TextBox x:Name="TagTextBox" Height="32" FontSize="12"
                                                 Text="{Binding TagText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Tags for this wallpaper"
                                                 ToolTip="Comma-separated tags" />
                                        <!-- Overlay hint: visible only while the TextBox is empty.
                                             A DataTrigger on Text needs no converter and keeps
                                             the TagText binding as the single source of truth. -->
                                        <TextBlock Text="e.g. nature, blue, minimal" IsHitTestVisible="False"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TagTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" Padding="8,5,8,5"
                                            MinHeight="32" FontSize="12"
                                            AutomationProperties.Name="Save tags"
                                            ToolTip="Save tags for this wallpaper"
                                            Command="{Binding DataContext.SetTagsCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8EC;" Style="{StaticResource Glyph}"
                                                       FontSize="13" Margin="0,0,4,0" />
                                            <TextBlock Text="Tags" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding TagStatus}"
                                               Style="{StaticResource CardMeta}" Margin="1,3,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Polished empty state, shown only when the current page has no cards. -->
            <Border Grid.Row="0" Padding="28" CornerRadius="16" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="58" Height="58" CornerRadius="15" Background="{StaticResource PanelAltBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7AA;" Style="{StaticResource Glyph}" FontSize="30"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="Your library is waiting" Style="{StaticResource SectionTitleStyle}"
                               HorizontalAlignment="Center" Margin="0,14,0,8" />
                    <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" MaxWidth="380" />
                    <TextBlock Text="Import a folder, save wallpapers from Discover, or clear a filter to see more."
                               Style="{StaticResource CardMeta}" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center"
                               Margin="0,12,0,0" MaxWidth="360" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pager. -->
        <Border Grid.Row="4" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="0,12,0,0" Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="10,8" MinHeight="32"
                        AutomationProperties.Name="Previous library page"
                        ToolTip="Show the previous page of saved wallpapers">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="13"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="Previous" FontSize="12" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding PageLabel}" Style="{StaticResource CaptionTextStyle}"
                           FontSize="12" VerticalAlignment="Center" Margin="16,0,16,0" />
                <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="10,8" MinHeight="32"
                        AutomationProperties.Name="Next library page"
                        ToolTip="Show the next page of saved wallpapers">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Next" FontSize="12" />
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="13"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Themed, in-app removal confirmation. Nothing is deleted until Confirm is pressed,
             and the file is only deleted when the checkbox is explicitly ticked. -->
        <Grid Grid.RowSpan="5" Panel.ZIndex="10" KeyboardNavigation.TabNavigation="Cycle"
              FocusManager.FocusedElement="{Binding ElementName=ConfirmRemoveButton}"
              Visibility="{Binding IsRemoveConfirmationOpen, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="{StaticResource WindowBrush}" Opacity="0.78" />
            <Border Width="420" MaxWidth="440" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="22" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Confirm wallpaper removal">
                <StackPanel>
                    <TextBlock Text="Remove from library" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding RemoveConfirmationText}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                    <CheckBox IsChecked="{Binding DeleteFileOnRemove}" Margin="0,16,0,0" Cursor="Hand"
                              TabIndex="0"
                              AutomationProperties.Name="Also delete the image file from disk"
                              ToolTip="Tick to delete the file as well as the library entry">
                        <TextBlock Text="Also delete the image file from disk" FontSize="12"
                                   TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="Left unchecked, only the library entry is removed and the file is kept."
                               Style="{StaticResource CardMeta}" TextWrapping="Wrap"
                               Margin="24,4,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Cancel" Padding="14,8,14,8" Margin="0,0,8,0" MinHeight="32"
                                TabIndex="1" IsCancel="True"
                                AutomationProperties.Name="Cancel removal"
                                ToolTip="Keep this wallpaper in the library"
                                Command="{Binding CancelRemoveCommand}" />
                        <Button x:Name="ConfirmRemoveButton" Style="{StaticResource PrimaryButtonStyle}"
                                Content="Remove" Padding="14,8,14,8" MinHeight="32" TabIndex="2" IsDefault="True"
                                AutomationProperties.Name="Confirm removal"
                                ToolTip="Remove this wallpaper from the library"
                                Command="{Binding ConfirmRemoveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
