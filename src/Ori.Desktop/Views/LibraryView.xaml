<UserControl x:Class="Ori.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="960"
             Background="{StaticResource WindowBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- The only local ComboBox template in the app: the editable collection
             mover needs PART_EditableTextBox in addition to the toggle and popup.
             Typing a fresh name and pressing Move creates a collection. -->
        <Style x:Key="EditableComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{StaticResource BodySize}" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             CaretBrush="{StaticResource AccentBrush}"
                                             FontSize="{TemplateBinding FontSize}"
                                             Padding="7,3,2,3" VerticalContentAlignment="Center"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" />
                                    <ToggleButton x:Name="PART_DropDownToggle" Grid.Column="1"
                                                  Background="Transparent" BorderThickness="0"
                                                  Focusable="False" Cursor="Hand" ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <Path Data="M 0 3 L 5 8 L 10 3" Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="1.5" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource PanelAltBrush}"
                                        BorderBrush="{StaticResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Toolbar: filters and the page's single commit on row one,
             low-priority library actions on row two. -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,24">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Grid Width="240" MinHeight="32" Margin="0,0,12,8">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="32,5,10,5" MinHeight="32"
                                 AutomationProperties.Name="Search library"
                                 ToolTip="Search saved wallpapers by title, id, collection or tag" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14"
                                   Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"
                                   HorizontalAlignment="Left" Margin="10,0,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                        <TextBlock Text="Tag" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                        <TextBox Width="120" MinHeight="32"
                                 Text="{Binding TagFilterText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Filter library by tag"
                                 ToolTip="Show wallpapers with this tag; separate several tags with commas to match any" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ClearTagFilterCommand}" Margin="4,0,0,0"
                                AutomationProperties.Name="Clear tag filter"
                                ToolTip="Remove the tag filter">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="13"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                        <TextBlock Text="Collection" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                        <ComboBox Width="140" MinHeight="32"
                                  ItemsSource="{Binding CollectionFilters}"
                                  SelectedItem="{Binding SelectedCollectionFilter}"
                                  AutomationProperties.Name="Filter by collection"
                                  ToolTip="Show wallpapers from one collection" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                        <TextBlock Text="Sort" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                        <ComboBox Width="112" MinHeight="32"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}"
                                  AutomationProperties.Name="Sort library"
                                  ToolTip="Choose how saved wallpapers are ordered" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding FavoritesOnly}" Margin="0,0,12,8"
                              VerticalAlignment="Center" Cursor="Hand"
                              AutomationProperties.Name="Favourites only"
                              ToolTip="Show only wallpapers marked as favourites">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="13"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,4,0" />
                            <TextBlock Text="Favourites only" />
                        </StackPanel>
                    </CheckBox>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                        <TextBlock Text="Apply to" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                        <ComboBox Width="172" MinHeight="32"
                                  ItemsSource="{Binding Displays}"
                                  SelectedItem="{Binding SelectedDisplay}"
                                  DisplayMemberPath="DeviceName"
                                  AutomationProperties.Name="Target display for Set wallpaper"
                                  ToolTip="Choose which display receives the applied wallpaper" />
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8"
                            Command="{Binding ApplyCommand}"
                            CommandParameter="{Binding SelectedEntry}"
                            AutomationProperties.Name="Set selected wallpaper"
                            ToolTip="Apply the selected wallpaper to the target display">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="Set wallpaper" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButtonStyle}" Click="OnImportFolderClick"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Import folder"
                            ToolTip="Import all images from a folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="13"
                                       Margin="0,0,4,0" />
                            <TextBlock Text="Import folder…" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="New collection" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                        <TextBox Width="140" MinHeight="32"
                                 Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="New collection name"
                                 ToolTip="Type a name and press Create. Selecting a wallpaper moves it in; with none selected the collection is created empty." />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding CreateCollectionCommand}" Margin="4,0,0,0"
                                AutomationProperties.Name="Create collection"
                                ToolTip="Create the named collection, moving the selected wallpaper into it if one is selected">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="13"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="Create" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding FindDuplicatesCommand}" Margin="0,0,8,0"
                            AutomationProperties.Name="Find duplicate wallpapers"
                            ToolTip="Scan the index for duplicate wallpapers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D5;" Style="{StaticResource Glyph}" FontSize="13"
                                       Margin="0,0,4,0" />
                            <TextBlock Text="Find duplicates" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding RefreshCommand}" IsEnabled="{Binding IsRefreshEnabled}"
                            AutomationProperties.Name="Refresh library"
                            ToolTip="Reload the library index">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13"
                                       Margin="0,0,4,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 2. Transient panels: only the active one takes space. -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16"
                    Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ImportProgress}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16"
                    Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding DuplicateStatus}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Only redundant copies are listed: one wallpaper per group was kept as the original. Removing a row deletes its library entry only; the image file is kept."
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding Duplicates}" Margin="0,8,0,0" MaxHeight="220">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                                            Margin="8,0,0,0"
                                            ToolTip="Remove only this redundant library entry; the original and the image file are kept"
                                            AutomationProperties.Name="Remove duplicate entry"
                                            Command="{Binding DataContext.RemoveDuplicateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 3. Gallery: 288 px cards with 12 px gutters. -->
        <Grid Grid.Row="2">
            <!-- The VM realizes at most one page (48 cards) at a time, so a WrapPanel
                 keeps memory bounded without a custom virtualizing panel. -->
            <ListBox x:Name="EntriesListBox"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     AutomationProperties.Name="Saved wallpapers"
                     ToolTip="Select a wallpaper to create a collection with it">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="CardSelection" Background="Transparent"
                                            BorderBrush="Transparent" BorderThickness="2"
                                            CornerRadius="{StaticResource CardCornerRadius}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="CardSelection" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="CardSelection" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <!-- Lazy thumbnail decode: fire only for realized cards.
                             Loaded covers first realization; DataContextChanged covers recycled cards. -->
                        <EventSetter Event="Loaded" Handler="OnCardLoaded" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="288" Padding="16"
                                CornerRadius="{StaticResource CardCornerRadius}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- Thumbnail with a favourite badge overlay. -->
                                <Grid Height="128">
                                    <Border CornerRadius="{StaticResource ControlCornerRadius}" ClipToBounds="True"
                                            Background="{StaticResource PanelAltBrush}">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,8,8,0"
                                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="12"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="Saved" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,4" />
                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                                <!-- One compact meta strip for collection, favourite and palette. -->
                                <WrapPanel Margin="0,0,0,8">
                                    <Border Style="{StaticResource ChipStyle}" Margin="0,0,4,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="12"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding SelectedCollection}"
                                                       Style="{StaticResource CaptionTextStyle}" MaxWidth="118" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}" Margin="0,0,4,4"
                                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="12"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="Favourite" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Computed tags are read-only chips here; the editable
                                         tag box below is the place to change them. -->
                                    <ItemsControl ItemsSource="{Binding TagChips}" MaxWidth="250"
                                                  Margin="0,0,4,4" HorizontalAlignment="Left"
                                                  AutomationProperties.Name="Tags on this wallpaper"
                                                  ToolTip="{Binding TagsText}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTags}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChipStyle}" Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextStyle}"
                                                               MaxWidth="110" TextTrimming="CharacterEllipsis"
                                                               AutomationProperties.Name="{Binding StringFormat='Tag: {0}'}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                Visibility="{Binding HasColors, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Colours" Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <ItemsControl ItemsSource="{Binding ColorSwatches}"
                                                      ToolTip="{Binding ColorsText}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="14" Height="14" CornerRadius="3"
                                                            Background="{Binding}" Margin="0,0,4,0"
                                                            BorderBrush="{StaticResource ControlBorderBrush}"
                                                            BorderThickness="1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Card commit: secondary, never a second primary. -->
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Set this wallpaper"
                                        ToolTip="Apply this wallpaper to the target display">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="Set wallpaper" />
                                    </StackPanel>
                                </Button>

                                <!-- Low-priority card actions: ghost. -->
                                <UniformGrid Columns="3" Rows="1" Margin="0,8,0,8">
                                    <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,4,0"
                                            Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding FavoriteLabel, StringFormat='Toggle favourite: {0}'}"
                                            ToolTip="Toggle favourite for this wallpaper">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="13"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding FavoriteLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButtonStyle}" Margin="4,0,4,0"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Open wallpaper in viewer"
                                            ToolTip="Open the saved image in your image viewer">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="13"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="Open" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButtonStyle}" Margin="4,0,0,0"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Remove wallpaper from library"
                                            ToolTip="Open the removal confirmation; nothing is deleted until you confirm">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="Remove" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <!-- Collection move row: editable so a typed name becomes a collection. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" MinHeight="32"
                                              Style="{StaticResource EditableComboBox}"
                                              IsEditable="True"
                                              AutomationProperties.Name="Move to collection"
                                              ToolTip="Pick a collection or type a new name, then press Move"
                                              ItemsSource="{Binding DataContext.MoveTargets, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                              Text="{Binding SelectedCollection, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="4,0,0,0"
                                            AutomationProperties.Name="Move to selected collection"
                                            ToolTip="Move to selected collection"
                                            Command="{Binding DataContext.MoveToCollectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8DE;" Style="{StaticResource Glyph}" FontSize="13"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="Move" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Tags row: labelled input with an in-place watermark. The
                                     hint collapses as soon as TagText has a value, so the box
                                     never reads as an empty, unlabelled rectangle. -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Add tags"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Grid.Row="1" Grid.Column="0">
                                        <TextBox x:Name="TagTextBox" MinHeight="32"
                                                 Text="{Binding TagText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Tags for this wallpaper"
                                                 ToolTip="Comma-separated tags" />
                                        <!-- Overlay hint: visible only while the TextBox is empty.
                                             A DataTrigger on Text needs no converter and keeps
                                             the TagText binding as the single source of truth. -->
                                        <TextBlock Text="e.g. nature, blue, minimal" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TagTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="4,0,0,0"
                                            AutomationProperties.Name="Save tags"
                                            ToolTip="Save tags for this wallpaper"
                                            Command="{Binding DataContext.SetTagsCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8EC;" Style="{StaticResource Glyph}" FontSize="13"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="Tags" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding TagStatus}"
                                               Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state, shown only when the current page has no cards. -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanelStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource PanelAltBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7AA;" Style="{StaticResource Glyph}" FontSize="30"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource TitleTextStyle}"
                               HorizontalAlignment="Center" Margin="0,16,0,8" />
                    <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource StatusTextStyle}"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Text="Import a folder, save wallpapers from Discover, or clear a filter to see more."
                               Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. One bottom status line. Detection failures keep their own line because
             the refresh on load overwrites Status. -->
        <StackPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="13"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding DisplayDetectionError}" Style="{StaticResource StatusTextStyle}"
                       Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                       Margin="24,4,0,0"
                       Visibility="{Binding HasDisplayDetectionError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- 5. Pager. -->
        <Border Grid.Row="4" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"
                        AutomationProperties.Name="Previous library page"
                        ToolTip="Show the previous page of saved wallpapers">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="13"
                                   Margin="0,0,4,0" />
                        <TextBlock Text="Previous" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding PageLabel}" Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center" Margin="16,0,16,0" />
                <Button Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"
                        AutomationProperties.Name="Next library page"
                        ToolTip="Show the next page of saved wallpapers">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Next" />
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="13"
                                   Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 6. Removal overlay. Nothing is deleted until Confirm is pressed, and the
             file is only deleted when the checkbox is explicitly ticked. -->
        <Grid Grid.RowSpan="5" Panel.ZIndex="10" KeyboardNavigation.TabNavigation="Cycle"
              FocusManager.FocusedElement="{Binding ElementName=ConfirmRemoveButton}"
              Visibility="{Binding IsRemoveConfirmationOpen, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="{StaticResource WindowBrush}" Opacity="0.78" />
            <Border Width="420" MaxWidth="440" Style="{StaticResource CardStyle}"
                    BorderBrush="{StaticResource StrongBorderBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    AutomationProperties.Name="Confirm wallpaper removal">
                <StackPanel>
                    <TextBlock Text="Remove from library" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding RemoveConfirmationText}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <CheckBox IsChecked="{Binding DeleteFileOnRemove}" Margin="0,16,0,0" Cursor="Hand"
                              TabIndex="0"
                              AutomationProperties.Name="Also delete the image file from disk"
                              ToolTip="Tick to delete the file as well as the library entry">
                        <TextBlock Text="Also delete the image file from disk"
                                   Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="Left unchecked, only the library entry is removed and the file is kept."
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                               Margin="24,4,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource GhostButtonStyle}" Content="Cancel"
                                Margin="0,0,8,0" TabIndex="1" IsCancel="True"
                                AutomationProperties.Name="Cancel removal"
                                ToolTip="Keep this wallpaper in the library"
                                Command="{Binding CancelRemoveCommand}" />
                        <Button x:Name="ConfirmRemoveButton" Style="{StaticResource PrimaryButtonStyle}"
                                Content="Confirm" TabIndex="2" IsDefault="True"
                                AutomationProperties.Name="Confirm removal"
                                ToolTip="Remove this wallpaper from the library"
                                Command="{Binding ConfirmRemoveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
