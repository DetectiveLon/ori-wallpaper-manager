<UserControl x:Class="Oriole.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Wallhaven API key -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="WALLHAVEN API KEY" Foreground="{StaticResource AccentBrush}"
                               FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Optional. Stored encrypted for this Windows user and used only for Wallhaven requests that need it (for example NSFW results). Search works without a key for SFW content."
                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="720" Margin="0,10,0,0" />
                    <PasswordBox x:Name="ApiKeyBox" PasswordChar="•" Height="34"
                                 Padding="10,6,10,6"
                                 Background="{StaticResource PanelAltBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource MutedBrush}"
                                 Margin="0,10,0,0" />
                    <DockPanel Margin="0,10,0,6">
                        <Button DockPanel.Dock="Right" Content="Remove key"
                                Command="{Binding RemoveApiKeyCommand}" Padding="14,8,14,8" Margin="8,0,0,0" />
                        <Button Content="Save API key"
                                Command="{Binding SaveApiKeyCommand}" Padding="14,8,14,8" />
                    </DockPanel>
                    <TextBlock Text="{Binding KeyStatus}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Local cache -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="LOCAL CACHE" Foreground="{StaticResource AccentBrush}"
                               FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Thumbnails and full-size downloads are cached to avoid repeat downloads. Clearing the cache never removes wallpapers you saved to your library."
                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="720" Margin="0,10,0,0" />
                    <Button Content="Clear cached images" Command="{Binding ClearCacheCommand}"
                            Padding="14,8,14,8" HorizontalAlignment="Left" Margin="0,10,0,6" />
                    <TextBlock Text="{Binding CacheStatus}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Launch at login -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="LAUNCH AT LOGIN" Foreground="{StaticResource AccentBrush}"
                               FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Register Oriole for the current Windows user so it starts quietly when you sign in. No administrator rights needed."
                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="720" Margin="0,10,0,0" />
                    <DockPanel Margin="0,10,0,6">
                        <Button DockPanel.Dock="Right" Content="{Binding StartupToggleLabel}"
                                Command="{Binding ToggleStartupCommand}" Padding="14,8,14,8" Margin="8,0,0,0" />
                        <CheckBox Content="Start Oriole when I sign in"
                                  IsChecked="{Binding StartupEnabled, Mode=OneWay}"
                                  Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                  IsEnabled="False" />
                    </DockPanel>
                    <TextBlock Text="{Binding StartupStatus}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Data & about -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="DATA &amp; ABOUT" Foreground="{StaticResource AccentBrush}"
                               FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Oriole keeps its data under your Windows user profile. Nothing is uploaded."
                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="720" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding LibraryPathText}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding SchedulesPathText}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding LogPathText}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding VersionInfo}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="0,6,0,0" />
                    <TextBlock Margin="0,10,0,0">
                        <Hyperlink NavigateUri="{Binding GitHubUrl}"
                                   RequestNavigate="OnRequestNavigate">
                            <Run Text="View the source on GitHub" />
                        </Hyperlink>
                    </TextBlock>
                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"
                            Padding="14,8,14,8" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
