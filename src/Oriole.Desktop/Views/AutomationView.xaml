<UserControl x:Class="Oriole.Desktop.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="960">
    <UserControl.Resources>
        <!-- Semantic status colours; all structural brushes come from App.xaml. -->
        <SolidColorBrush x:Key="RunningBrush" Color="#7FD1AE" />
        <SolidColorBrush x:Key="PausedBrush" Color="#E6B980" />
        <SolidColorBrush x:Key="IdleBrush" Color="#8FA0B5" />

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="MutedCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FinePrint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,8">

            <!-- Calm header card -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="18"
                    Padding="24" Margin="0,0,0,20"
                    BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="04  ·  AUTOMATION" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Automation on your terms." FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,9,0,8" />
                    <TextBlock Style="{StaticResource MutedCaption}" MaxWidth="720"
                               Text="Each display has its own interval and controls. Rotation normally uses wallpapers already saved in your local library. You can optionally let it fetch more from Wallhaven when the library runs dry." />

                    <Border Height="1" Background="{StaticResource ControlBorderBrush}"
                            Opacity="0.6" Margin="0,18,0,16" />

                    <!-- Global controls: full-screen pause master, Wallhaven opt-in, display refresh. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <CheckBox Content="Pause displays while a full-screen app is active (master switch)"
                                      IsChecked="{Binding PauseWhenFullscreen, Mode=TwoWay}"
                                      Foreground="{StaticResource TextBrush}" FontSize="12"
                                      VerticalAlignment="Center" />
                            <CheckBox Content="Auto-fetch from Wallhaven using current Discover filters"
                                      IsChecked="{Binding AutoFetchFromWallhaven, Mode=TwoWay}"
                                      Foreground="{StaticResource TextBrush}" FontSize="12"
                                      VerticalAlignment="Center" Margin="0,9,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh displays"
                                Command="{Binding RefreshDisplaysCommand}"
                                Padding="16,9" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Style="{StaticResource FinePrint}" Margin="0,12,0,0"
                               Text="Full-screen detection is based on the foreground window covering a display. Each card can opt out of it. Auto-fetch is off by default and only runs when a display has no unseen local wallpapers left; it uses whatever filters you last searched with in Discover." />
                </StackPanel>
            </Border>

            <TextBlock Text="DISPLAY SCHEDULES" Style="{StaticResource Eyebrow}"
                       Foreground="{StaticResource MutedBrush}" Margin="2,0,0,12" />

            <!-- One card per connected display -->
            <ItemsControl ItemsSource="{Binding Schedules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="16"
                                Padding="22" Margin="0,0,0,14"
                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
                            <StackPanel>

                                <!-- Display identity + live state pill -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Subheading}" Style="{StaticResource FinePrint}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="10" Padding="10,5"
                                            VerticalAlignment="Center" Margin="12,0,0,0"
                                            Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
                                        <TextBlock FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="RUNNING" />
                                                    <Setter Property="Foreground" Value="{StaticResource RunningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Countdown}" Value="Paused">
                                                            <Setter Property="Text" Value="PAUSED" />
                                                            <Setter Property="Foreground" Value="{StaticResource PausedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Countdown}" Value="Not running">
                                                            <Setter Property="Text" Value="IDLE" />
                                                            <Setter Property="Foreground" Value="{StaticResource IdleBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Countdown}" Value="Preparing…">
                                                            <Setter Property="Text" Value="STARTING" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Countdown}" Value="Applying…">
                                                            <Setter Property="Text" Value="APPLYING" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Status strip: state glyph / countdown / detail -->
                                <Border Background="{StaticResource PanelAltBrush}" CornerRadius="12"
                                        Padding="16,14" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="20" VerticalAlignment="Center"
                                                   Margin="0,0,14,0"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE768;" />
                                                    <Setter Property="Foreground" Value="{StaticResource RunningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Countdown}" Value="Paused">
                                                            <Setter Property="Text" Value="&#xE769;" />
                                                            <Setter Property="Foreground" Value="{StaticResource PausedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Countdown}" Value="Not running">
                                                            <Setter Property="Text" Value="&#xE71A;" />
                                                            <Setter Property="Foreground" Value="{StaticResource IdleBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Countdown}" Value="Preparing…">
                                                            <Setter Property="Text" Value="&#xE895;" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Countdown}" Value="Applying…">
                                                            <Setter Property="Text" Value="&#xE895;" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="NEXT CHANGE" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding Countdown}" FontSize="24" FontWeight="SemiBold"
                                                       Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Countdown}" Value="Paused">
                                                                <Setter Property="Foreground" Value="{StaticResource PausedBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Countdown}" Value="Not running">
                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource FinePrint}"
                                           Margin="2,10,0,0" />

                                <!-- Per-display full-screen pause opt-out -->
                                <CheckBox Content="Pause this display for full-screen apps"
                                          IsChecked="{Binding PauseWhenFullscreen, Mode=TwoWay}"
                                          Foreground="{StaticResource MutedBrush}" FontSize="11"
                                          Margin="2,8,0,0" />

                                <!-- Segmented control deck: interval selector | actions -->
                                <Border Background="#17212D" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="CHANGE EVERY" Style="{StaticResource FieldLabel}"
                                                       Margin="0,0,0,7" />
                                            <ComboBox ItemsSource="{Binding Intervals}"
                                                      SelectedItem="{Binding SelectedInterval, Mode=TwoWay}"
                                                      IsEnabled="{Binding IntervalEnabled}"
                                                      MinWidth="158" Height="36" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="1" Margin="0,4,16,4"
                                                Background="{StaticResource ControlBorderBrush}" Opacity="0.6" />
                                        <WrapPanel Grid.Column="2" VerticalAlignment="Bottom">
                                            <Button Content="Start" Style="{StaticResource PrimaryActionStyle}"
                                                    Command="{Binding StartCommand}"
                                                    IsEnabled="{Binding CanStart}" />
                                            <Button Content="{Binding PauseButtonText}" Padding="14,10" FontSize="12"
                                                    Margin="0,0,8,0" Command="{Binding PauseCommand}"
                                                    IsEnabled="{Binding CanPause}" />
                                            <Button Content="Previous" Padding="14,10" FontSize="12"
                                                    Margin="0,0,8,0" Command="{Binding PreviousCommand}"
                                                    IsEnabled="{Binding CanRotateNow}"
                                                    ToolTip="Re-apply the previous wallpaper on this display and restart the interval" />
                                            <Button Content="Rotate now" Padding="14,10" FontSize="12"
                                                    Margin="0,0,8,0" Command="{Binding RotateNowCommand}"
                                                    IsEnabled="{Binding CanRotateNow}" />
                                            <Button Content="Stop" Padding="14,10" FontSize="12"
                                                    Command="{Binding StopCommand}"
                                                    IsEnabled="{Binding CanStop}" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Library / display availability and refresh diagnostics -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14,12"
                    Margin="0,18,0,0" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding GlobalStatus}" Style="{StaticResource FinePrint}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>