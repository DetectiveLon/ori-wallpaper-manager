<UserControl x:Class="Oriole.Desktop.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Header -->
        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="#303F53"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="WALLPAPER AUTOMATION"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="Bold"
                           FontSize="11" />
                <TextBlock Text="A separate schedule for every screen."
                           Foreground="{StaticResource TextBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,8,0,6" />
                <TextBlock Text="Each display has its own interval and controls. Rotation uses wallpapers already saved in your local library, so scheduled changes never trigger background downloads."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,15" />

                <WrapPanel VerticalAlignment="Center">
                    <CheckBox Content="Pause a display's schedule while a full-screen app is active on it"
                              IsChecked="{Binding PauseWhenFullscreen, Mode=TwoWay}"
                              Foreground="{StaticResource TextBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <Button Content="Refresh displays"
                            Command="{Binding RefreshDisplaysCommand}"
                            Margin="0,0,8,7" />
                </WrapPanel>

                <TextBlock Text="Full-screen detection is based on the foreground window covering a display. It pauses for full-screen apps such as games and video players; it does not try to identify games by name."
                           Foreground="#8FA0B5"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- One card per connected display -->
        <ItemsControl ItemsSource="{Binding Schedules}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="#303F53"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subheading}"
                                       Foreground="#8FA0B5"
                                       FontSize="11"
                                       Margin="0,5,0,14" />

                            <TextBlock Text="NEXT CHANGE"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="10" />
                            <TextBlock Text="{Binding Countdown}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Margin="0,7,0,3" />
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />

                            <WrapPanel Margin="0,14,0,0">
                                <StackPanel Margin="0,0,12,7">
                                    <TextBlock Text="Change every"
                                               Foreground="#AEBCD0"
                                               FontSize="10"
                                               Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Intervals}"
                                              SelectedItem="{Binding SelectedInterval, Mode=TwoWay}"
                                              IsEnabled="{Binding IntervalEnabled}"
                                              MinWidth="148"
                                              Height="34" />
                                </StackPanel>

                                <Button Content="Start"
                                        Command="{Binding StartCommand}"
                                        IsEnabled="{Binding CanStart}"
                                        Padding="14,9"
                                        Margin="0,0,8,7" />
                                <Button Content="{Binding PauseButtonText}"
                                        Command="{Binding PauseCommand}"
                                        IsEnabled="{Binding CanPause}"
                                        Padding="14,9"
                                        Margin="0,0,8,7" />
                                <Button Content="Rotate now"
                                        Command="{Binding RotateNowCommand}"
                                        IsEnabled="{Binding CanRotateNow}"
                                        Padding="14,9"
                                        Margin="0,0,8,7" />
                                <Button Content="Stop"
                                        Command="{Binding StopCommand}"
                                        IsEnabled="{Binding CanStop}"
                                        Padding="14,9"
                                        Margin="0,0,8,7" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Library / display availability and refresh diagnostics -->
        <TextBlock Text="{Binding GlobalStatus}"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="2,12,2,0" />
    </StackPanel>
</UserControl>
