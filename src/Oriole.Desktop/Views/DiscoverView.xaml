<UserControl x:Class="Oriole.Desktop.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">
    <UserControl.Resources>
        <!-- Typography rhythm: 11px captions, 13px body. -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,17,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>

        <!-- Pill-shaped filter chips. IsChecked bindings stay two-way to the VM flags. -->
        <Style x:Key="FilterChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ControlCheckedBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action: accent pill with a Fluent search glyph beside its content. -->
        <Style x:Key="SearchButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Foreground="{TemplateBinding Foreground}"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#BBD5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#84ACF2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The colour palette chips reuse the app-wide implicit ToggleButton style. -->
        <Style x:Key="ColorChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="276" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Filter rail: scrollable groups, with the primary action pinned below them. -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14"
                Margin="0,0,14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,15,16,13">
                    <TextBlock Text="SEARCH WALLHAVEN" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Find your wallpaper" FontSize="18" FontWeight="SemiBold"
                               Margin="0,5,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="16,0,16,14">
                    <StackPanel>
                        <!-- TAGS -->
                        <TextBlock Text="TAGS" Style="{StaticResource GroupHeader}" Margin="0,2,0,8" />
                        <TextBlock Text="Keywords" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 Text="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Example: landscape, nature, -people" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Separate tags with commas. Prefix with - to exclude; + to require." />

                        <!-- CATEGORIES -->
                        <TextBlock Text="CATEGORIES" Style="{StaticResource GroupHeader}" />
                        <WrapPanel>
                            <ToggleButton Style="{StaticResource FilterChip}" Content="General"
                                          IsChecked="{Binding General, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource FilterChip}" Content="Anime"
                                          IsChecked="{Binding Anime, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource FilterChip}" Content="People"
                                          IsChecked="{Binding People, Mode=TwoWay}" />
                        </WrapPanel>

                        <!-- CONTENT -->
                        <TextBlock Text="CONTENT" Style="{StaticResource GroupHeader}" />
                        <WrapPanel>
                            <ToggleButton Style="{StaticResource FilterChip}" Content="SFW"
                                          IsChecked="{Binding Safe, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource FilterChip}" Content="Sketchy"
                                          IsChecked="{Binding Sketchy, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource FilterChip}" Content="NSFW"
                                          IsChecked="{Binding Explicit, Mode=TwoWay}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="NSFW results require your Wallhaven API key." />

                        <!-- WALLHAVEN -->
                        <TextBlock Text="WALLHAVEN" Style="{StaticResource GroupHeader}" />
                        <TextBlock Text="API key" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="ApiKeyBox" Height="32" Margin="0,0,0,10" Padding="9,5"
                                     Background="{StaticResource PanelAltBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource MutedBrush}" />
                        <TextBlock Text="Sorting" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                  ItemsSource="{Binding SortingChoices}"
                                  SelectedItem="{Binding SelectedSorting, Mode=TwoWay}" />
                        <TextBlock Text="Toplist period" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                  ItemsSource="{Binding TopRangeChoices}"
                                  SelectedItem="{Binding SelectedTopRange, Mode=TwoWay}" />
                        <TextBlock Text="Order" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                  ItemsSource="{Binding OrderChoices}"
                                  SelectedItem="{Binding SelectedOrder, Mode=TwoWay}" />

                        <!-- RESOLUTION -->
                        <TextBlock Text="RESOLUTION" Style="{StaticResource GroupHeader}" />
                        <TextBlock Text="Minimum resolution" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 Text="{Binding MinimumResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="1920x1080" />
                        <TextBlock Text="Exact resolution" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 Text="{Binding ExactResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="3840x2160" />
                        <TextBlock Text="Aspect ratio" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                  ItemsSource="{Binding RatioChoices}"
                                  SelectedItem="{Binding SelectedRatio, Mode=TwoWay}" />

                        <!-- COLOUR -->
                        <TextBlock Text="COLOUR" Style="{StaticResource GroupHeader}" />
                        <TextBlock Text="Palette colours" Style="{StaticResource FieldLabel}" />
                        <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ColorChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      ToolTip="{Binding ToolTip}" Style="{StaticResource ColorChip}"
                                                      Background="{StaticResource PanelAltBrush}"
                                                      BorderBrush="{StaticResource MutedBrush}"
                                                      BorderThickness="1" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="13" Height="13" CornerRadius="2"
                                                        Background="{Binding SwatchBrush}"
                                                        BorderBrush="{StaticResource MutedBrush}"
                                                        BorderThickness="1" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding Hex}" FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Custom hex values" Style="{StaticResource FieldLabel}" Margin="0,9,0,5" />
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 Text="{Binding CustomColors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Custom hex colors, comma-separated" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Your API key is saved locally (DPAPI-protected) and sent only to Wallhaven." />
                    </StackPanel>
                </ScrollViewer>

                <!-- Sticky primary action, separated from the scrolling filters. -->
                <Border Grid.Row="2" BorderBrush="{StaticResource ControlBorderBrush}"
                        BorderThickness="0,1,0,0" Padding="16,13">
                    <Button Content="Search wallpapers" Style="{StaticResource SearchButton}"
                            Command="{Binding SearchCommand}" HorizontalAlignment="Stretch" />
                </Border>
            </Grid>
        </Border>

        <!-- Results column -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status + target display -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="12"
                    Padding="14,11" Margin="0,0,0,12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="18,0,0,0">
                        <TextBlock Text="Apply to" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ComboBox Width="172" DisplayMemberPath="DeviceName"
                                  ItemsSource="{Binding Monitors}"
                                  SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <!-- The placeholder status is replaced by the real empty state below. -->
                                    <DataTrigger Binding="{Binding Status}" Value="Choose filters and search.">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardSelection" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="2" CornerRadius="14">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardSelection" Property="BorderBrush"
                                                        Value="{StaticResource MutedBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardSelection" Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="214" Background="{StaticResource PanelBrush}" CornerRadius="12"
                                    Padding="9" Margin="0,0,12,12" BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <Border Height="126" Background="{StaticResource PanelAltBrush}"
                                            CornerRadius="7" ClipToBounds="True">
                                        <Image Width="194" Height="126" Stretch="UniformToFill"
                                               Source="{Binding Thumbnail}" />
                                    </Border>
                                    <TextBlock Text="{Binding Resolution}" FontSize="13" FontWeight="SemiBold"
                                               Margin="1,9,0,3" />
                                    <TextBlock Text="{Binding Meta}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="1,0,0,9" />
                                    <UniformGrid Columns="2" Rows="2">
                                        <Button Content="Open page" Margin="0,0,4,4" FontSize="11" Padding="6,6,6,6"
                                                Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Preview" Margin="4,0,0,4" FontSize="11" Padding="6,6,6,6"
                                                Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Save to library" Margin="0,4,4,0" FontSize="11"
                                                Style="{StaticResource PrimaryButtonStyle}" Padding="6,6,6,6"
                                                Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Apply" Margin="4,4,0,0" FontSize="11" Padding="6,6,6,6"
                                                Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Genuine empty state: large Fluent glyph, headline, one guidance line. -->
                <Border Background="{StaticResource WindowBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <Border Width="108" Height="108" CornerRadius="54"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="54" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No wallpapers yet" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,20,0,7" />
                        <TextBlock Text="Choose your filters, then select Search wallpapers to explore Wallhaven."
                                   FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="380" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pager -->
            <Border Grid.Row="2" Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" Content="Previous" Padding="12,7,12,7"
                            Command="{Binding PreviousCommand}" />
                    <Button DockPanel.Dock="Right" Content="Next" Padding="12,7,12,7"
                            Command="{Binding NextCommand}" />
                    <TextBlock Text="{Binding PageText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
