<UserControl x:Class="Oriole.Desktop.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>
        <Style x:Key="HintLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="33" />
            <Setter Property="Padding" Value="8,5,8,5" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style x:Key="FilterCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,3,12,3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="286" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: the filter list is height-capped so Search stays reachable. -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14"
                Padding="16" Margin="0,0,14,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Bottom" Content="Search wallpapers"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SearchCommand}" Margin="0,12,0,0" />

                <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="SEARCH WALLHAVEN" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Find your wallpaper" FontSize="19" FontWeight="SemiBold"
                                   Margin="0,7,0,14" />

                        <TextBlock Text="Tags" Style="{StaticResource SectionLabel}" />
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 Text="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Example: landscape, nature, -people" />
                        <TextBlock Style="{StaticResource HintLabel}" Margin="0,4,0,12"
                                   Text="Separate tags with commas. Prefix with - to exclude; + to require." />

                        <TextBlock Text="Categories" Style="{StaticResource SectionLabel}" />
                        <WrapPanel>
                            <CheckBox Style="{StaticResource FilterCheckBox}" Content="General"
                                      IsChecked="{Binding General, Mode=TwoWay}" />
                            <CheckBox Style="{StaticResource FilterCheckBox}" Content="Anime"
                                      IsChecked="{Binding Anime, Mode=TwoWay}" />
                            <CheckBox Style="{StaticResource FilterCheckBox}" Content="People"
                                      IsChecked="{Binding People, Mode=TwoWay}" />
                        </WrapPanel>

                        <TextBlock Text="Content" Style="{StaticResource SectionLabel}" />
                        <WrapPanel>
                            <CheckBox Style="{StaticResource FilterCheckBox}" Content="SFW"
                                      IsChecked="{Binding Safe, Mode=TwoWay}" />
                            <CheckBox Style="{StaticResource FilterCheckBox}" Content="Sketchy"
                                      IsChecked="{Binding Sketchy, Mode=TwoWay}" />
                            <CheckBox Style="{StaticResource FilterCheckBox}" Content="NSFW"
                                      IsChecked="{Binding Explicit, Mode=TwoWay}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintLabel}" Margin="0,5,0,0"
                                   Text="NSFW results require your Wallhaven API key." />
                        <PasswordBox x:Name="ApiKeyBox" Height="32" Margin="0,5,0,12" Padding="8,5,8,5"
                                     Background="{StaticResource PanelAltBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource MutedBrush}" />

                        <TextBlock Text="Sorting" Style="{StaticResource SectionLabel}" />
                        <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                  ItemsSource="{Binding SortingChoices}"
                                  SelectedItem="{Binding SelectedSorting, Mode=TwoWay}" />
                        <TextBlock Text="Toplist period" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,9,0,0" />
                        <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                  ItemsSource="{Binding TopRangeChoices}"
                                  SelectedItem="{Binding SelectedTopRange, Mode=TwoWay}" />
                        <TextBlock Text="Order" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,9,0,0" />
                        <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                  ItemsSource="{Binding OrderChoices}"
                                  SelectedItem="{Binding SelectedOrder, Mode=TwoWay}" />

                        <TextBlock Text="Minimum resolution" Style="{StaticResource SectionLabel}" />
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 Text="{Binding MinimumResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="1920x1080" />

                        <TextBlock Text="Exact resolution" Style="{StaticResource SectionLabel}" />
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 Text="{Binding ExactResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="3840x2160" />

                        <TextBlock Text="Aspect ratio" Style="{StaticResource SectionLabel}" />
                        <ComboBox Style="{StaticResource FieldCombo}" DisplayMemberPath="Label"
                                  ItemsSource="{Binding RatioChoices}"
                                  SelectedItem="{Binding SelectedRatio, Mode=TwoWay}" />

                        <TextBlock Text="Colours (select palette colours or enter custom hex values)"
                                   Style="{StaticResource SectionLabel}" />
                        <ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ColorChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      ToolTip="{Binding ToolTip}" Padding="4" Margin="2"
                                                      Background="{StaticResource PanelAltBrush}"
                                                      BorderBrush="{StaticResource MutedBrush}"
                                                      BorderThickness="1" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="13" Height="13" CornerRadius="2"
                                                        Background="{Binding SwatchBrush}"
                                                        BorderBrush="{StaticResource MutedBrush}"
                                                        BorderThickness="1" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding Hex}" FontSize="9"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 Text="{Binding CustomColors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Custom hex colors, comma-separated" />

                        <TextBlock Style="{StaticResource HintLabel}" Margin="0,9,0,0"
                                   Text="Your API key is saved locally (DPAPI-protected) and sent only to Wallhaven." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Apply to" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,8,0" VerticalAlignment="Center" />
                    <ComboBox Width="172" DisplayMemberPath="DeviceName"
                              ItemsSource="{Binding Monitors}"
                              SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="CardSelection" Background="Transparent"
                                            BorderBrush="Transparent" BorderThickness="2" CornerRadius="14">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardSelection" Property="BorderBrush"
                                                    Value="{StaticResource MutedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="CardSelection" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="214" Background="{StaticResource PanelBrush}" CornerRadius="12"
                                Padding="9" Margin="0,0,12,12">
                            <StackPanel>
                                <Border Height="126" Background="{StaticResource PanelAltBrush}"
                                        CornerRadius="7" ClipToBounds="True">
                                    <Image Width="194" Height="126" Stretch="UniformToFill"
                                           Source="{Binding Thumbnail}" />
                                </Border>
                                <TextBlock Text="{Binding Resolution}" FontSize="12" FontWeight="SemiBold"
                                           Margin="1,9,0,2" />
                                <TextBlock Text="{Binding Meta}" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="1,0,0,8" />
                                <UniformGrid Columns="2" Rows="2">
                                    <Button Content="Open page" Margin="0,0,4,4" FontSize="11" Padding="6,6,6,6"
                                            Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Preview" Margin="4,0,0,4" FontSize="11" Padding="6,6,6,6"
                                            Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Save to library" Margin="0,4,4,0" FontSize="11"
                                            Style="{StaticResource PrimaryButtonStyle}" Padding="6,6,6,6"
                                            Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Apply" Margin="4,4,0,0" FontSize="11" Padding="6,6,6,6"
                                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button DockPanel.Dock="Left" Content="Previous" Padding="12,7,12,7"
                        Command="{Binding PreviousCommand}" />
                <Button DockPanel.Dock="Right" Content="Next" Padding="12,7,12,7"
                        Command="{Binding NextCommand}" />
                <TextBlock Text="{Binding PageText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
