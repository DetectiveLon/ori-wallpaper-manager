<UserControl x:Class="Oriole.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="960">
    <UserControl.Resources>
        <!-- Calm, flat card button used for the six navigation tiles. -->
        <Style x:Key="OverviewCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="19" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#263344" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#30445C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,8">
            <!-- Hero -->
            <Border Background="#202D3D" CornerRadius="18" Padding="26" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" MaxWidth="600">
                        <TextBlock Text="A calmer way to change your wallpaper."
                                   FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Find high-resolution images, shape your own collections, and give every display its own setup. No live wallpapers. No unnecessary background activity."
                                   FontSize="13" Foreground="#B7C6D8" TextWrapping="Wrap" Margin="0,11,0,18" />
                        <Button Content="Explore wallpapers"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Discover" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="174" Height="132" CornerRadius="13"
                            Background="#31445B" Margin="24,0,0,0">
                        <Grid>
                            <Ellipse Width="90" Height="90" Fill="#7897B8" Opacity="0.45"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="15,0,0,10" />
                            <Ellipse Width="62" Height="62" Fill="#B7D1EE" Opacity="0.55"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,18,0" />
                            <Rectangle Height="40" Fill="#1B2938" VerticalAlignment="Bottom" Opacity="0.65" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="GET STARTED" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource MutedBrush}" Margin="2,0,0,11" />

            <!-- Six navigation cards -->
            <UniformGrid Columns="3" Rows="2">
                <Button Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Overview">
                    <StackPanel>
                        <TextBlock Text="00  ·  OVERVIEW" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Your desktop, in order." FontSize="16" FontWeight="SemiBold"
                                   Margin="0,9,0,6" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="A calm starting point for everything Oriole can do."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Discover">
                    <StackPanel>
                        <TextBlock Text="01  ·  DISCOVER" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Find your next wallpaper" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,9,0,6" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Search by tags, category, resolution, orientation, colour and popularity."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Library">
                    <StackPanel>
                        <TextBlock Text="02  ·  LIBRARY" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Keep the good ones" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,9,0,6" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Save images, organise them into collections, and use them offline."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Displays">
                    <StackPanel>
                        <TextBlock Text="03  ·  DISPLAYS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Set up every screen" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,9,0,6" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Assign different images and fitting rules to each connected monitor."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Automation">
                    <StackPanel>
                        <TextBlock Text="04  ·  AUTOMATION" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Rotate on your terms" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,9,0,6" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Set a clear interval, see the next change, and pause while you are gaming."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Settings">
                    <StackPanel>
                        <TextBlock Text="05  ·  SETTINGS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Tune the essentials" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,9,0,6" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Manage your Wallhaven API key, cached images and local data."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Border Background="#18212C" CornerRadius="12" Padding="14" Margin="0,22,0,0">
                <TextBlock Text="Preview build. Discovery, local library, per-display rotation with restart persistence, and full-screen pause are implemented; there is no installer yet."
                           FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
