<UserControl x:Class="Oriole.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="960">
    <UserControl.Resources>
        <!-- Deep, angled wash that gives the hero depth without any bitmap. -->
        <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#21334A" Offset="0" />
            <GradientStop Color="#182535" Offset="0.55" />
            <GradientStop Color="#141C26" Offset="1" />
        </LinearGradientBrush>

        <!-- Soft accent halo behind the decorative artwork. -->
        <RadialGradientBrush x:Key="HeroGlowBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#5C86CC" Offset="0" />
            <GradientStop Color="#2D4A73" Offset="0.55" />
            <GradientStop Color="#00131F28" Offset="1" />
        </RadialGradientBrush>

        <!-- Hover wash for the navigation cards. -->
        <LinearGradientBrush x:Key="CardHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#293C54" Offset="0" />
            <GradientStop Color="#223144" Offset="1" />
        </LinearGradientBrush>

        <!-- Navigation tile: generous padding, subtle border, clear hover/press lift. -->
        <Style x:Key="OverviewCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#2B3B4E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Surface">
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="18" SnapsToDevicePixels="True" />
                            <Border x:Name="CardHighlight" CornerRadius="18"
                                    Background="{StaticResource CardHoverBrush}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="22,20"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#5E82B2" />
                                <Setter TargetName="CardHighlight" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#2A3D54" />
                                <Setter TargetName="CardHighlight" Property="Opacity" Value="0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,30,36,26" MaxWidth="1180" HorizontalAlignment="Left">

            <!-- Hero: eyebrow, two-tone headline, supporting copy and one primary CTA. -->
            <Border CornerRadius="24" Padding="34,32" Margin="0,0,0,6"
                    Background="{StaticResource HeroBackgroundBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="5" Opacity="0.30" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="520">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Rectangle Width="22" Height="2" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" />
                            <TextBlock Text="WELCOME TO ORIOLE" Margin="11,0,0,0"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap" FontSize="38" FontWeight="SemiBold"
                                   LineHeight="46" Foreground="{StaticResource TextBrush}">
                            <Run Text="Find it. Keep it. " />
                            <Run Text="Make it yours." Foreground="{StaticResource AccentBrush}" />
                        </TextBlock>

                        <TextBlock Text="Find high-resolution wallpapers, keep the ones you love, and give every display its own setup. No live wallpapers, no unnecessary background activity."
                                   FontSize="14" LineHeight="23" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,14,0,24" />

                        <Button Style="{StaticResource PrimaryButtonStyle}" Tag="Discover"
                                HorizontalAlignment="Left" Padding="22,13"
                                Command="{Binding NavigateCommand}" CommandParameter="Discover">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Explore wallpapers" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#101722" VerticalAlignment="Center" />
                                <Path Data="M 0 0 L 6 5 L 0 10" Margin="12,0,0,0" VerticalAlignment="Center"
                                      Stroke="#101722" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Decorative wallpaper stack: pure XAML shapes and gradients. -->
                    <Grid Grid.Column="1" Width="262" Height="200" Margin="18,0,0,0"
                          IsHitTestVisible="False">
                        <Ellipse Width="300" Height="270" Fill="{StaticResource HeroGlowBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Border Width="164" Height="130" CornerRadius="16" Margin="8,18,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#25364A" BorderBrush="#3A5270" BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-9" />
                            </Border.RenderTransform>
                        </Border>

                        <Border Width="178" Height="140" CornerRadius="16" Margin="0,0,6,10"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                BorderBrush="#5E82B2" BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="6" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#33527A" Offset="0" />
                                    <GradientStop Color="#16283A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="1">
                                <Ellipse Width="34" Height="34" Fill="#F3D9AE" Opacity="0.92"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,24,0" />
                                <Path Data="M 0,98 L 50,50 L 92,92 L 128,60 L 178,110 L 178,140 L 0,140 Z"
                                      Fill="#1D3E53" Opacity="0.92" Stretch="None"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <Path Data="M 0,116 L 42,80 L 82,116 L 120,92 L 178,134 L 178,140 L 0,140 Z"
                                      Fill="#122B3C" Opacity="0.95" Stretch="None"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <Path Data="M 0,0 L 54,0 L 0,54 Z" Fill="#FFFFFF" Opacity="0.05"
                                      Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </Grid>
                        </Border>

                        <Border Width="36" Height="36" CornerRadius="18" Margin="0,2,4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Opacity="0.85" />
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,17,0" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Get started section heading. -->
            <StackPanel Margin="4,30,0,17">
                <TextBlock Text="GET STARTED" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                <TextBlock Text="Six ways to make Oriole yours." FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
            </StackPanel>

            <!-- Six navigation cards; wrap cleanly instead of squeezing into a fixed grid. -->
            <WrapPanel>
                <Button Width="272" Height="178" Margin="0,0,14,14"
                        Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Overview">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="01" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                            <Border Width="36" Height="36" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#26384E" BorderBrush="#34506F" BorderThickness="1">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Overview" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Grid.Row="2" Text="A calm starting point for everything Oriole can do."
                                   FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                    </Grid>
                </Button>

                <Button Width="272" Height="178" Margin="0,0,14,14"
                        Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Discover">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="02" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                            <Border Width="36" Height="36" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#26384E" BorderBrush="#34506F" BorderThickness="1">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Discover" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Grid.Row="2" Text="Search by tags, category, resolution, colour and popularity."
                                   FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                    </Grid>
                </Button>

                <Button Width="272" Height="178" Margin="0,0,14,14"
                        Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Library">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="03" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                            <Border Width="36" Height="36" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#26384E" BorderBrush="#34506F" BorderThickness="1">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Library" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Grid.Row="2" Text="Save the images you love and organise them into collections."
                                   FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                    </Grid>
                </Button>

                <Button Width="272" Height="178" Margin="0,0,14,14"
                        Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Displays">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="04" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                            <Border Width="36" Height="36" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#26384E" BorderBrush="#34506F" BorderThickness="1">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Displays" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Grid.Row="2" Text="Give every monitor its own image and fitting rule."
                                   FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                    </Grid>
                </Button>

                <Button Width="272" Height="178" Margin="0,0,14,14"
                        Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Automation">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="05" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                            <Border Width="36" Height="36" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#26384E" BorderBrush="#34506F" BorderThickness="1">
                                <TextBlock Text="&#xE8B3;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Automation" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Grid.Row="2" Text="Rotate on a clear interval and pause while you are gaming."
                                   FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                    </Grid>
                </Button>

                <Button Width="272" Height="178" Margin="0,0,14,14"
                        Style="{StaticResource OverviewCardStyle}"
                        Command="{Binding NavigateCommand}" CommandParameter="Settings">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="06" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                            <Border Width="36" Height="36" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#26384E" BorderBrush="#34506F" BorderThickness="1">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Settings" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Grid.Row="2" Text="Manage your Wallhaven API key, cached images and local data."
                                   FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                    </Grid>
                </Button>
            </WrapPanel>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="#263446" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Top" Margin="0,6,11,0" />
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Text="Preview build. Discovery, local library, per-display rotation with restart persistence, and full-screen pause are implemented; there is no installer yet." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
