<UserControl x:Class="Oriole.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="Search library" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="240" Height="34" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Collection" VerticalAlignment="Center" Margin="12,0,8,0" />
                <ComboBox Width="170" Height="34"
                          ItemsSource="{Binding CollectionFilters}"
                          SelectedItem="{Binding SelectedCollectionFilter}" />
                <CheckBox Content="Favorites only" Margin="12,0,12,0" VerticalAlignment="Center"
                          Foreground="{StaticResource TextBrush}"
                          IsChecked="{Binding FavoritesOnly}" />
                <Button Content="Refresh" Padding="12,7,12,7"
                        IsEnabled="{Binding IsRefreshEnabled}"
                        Command="{Binding RefreshCommand}" />
            </WrapPanel>

            <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="Apply target" VerticalAlignment="Center" Margin="0,0,9,0" />
                <ComboBox Width="200" Height="34"
                          ItemsSource="{Binding Displays}"
                          SelectedItem="{Binding SelectedDisplay}"
                          DisplayMemberPath="DeviceName" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- Virtualized card list: only realized rows get a container / decoded image. -->
            <ListBox x:Name="EntriesListBox"
                     ItemsSource="{Binding Entries}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="230" />
                        <Setter Property="Margin" Value="0,0,12,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <!-- Lazy thumbnail decode: fire only for realized cards.
                             Loaded covers first realization; DataContextChanged covers recycled rows. -->
                        <EventSetter Event="Loaded" Handler="OnCardLoaded" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="264" Height="222" Padding="9" CornerRadius="12"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource PanelAltBrush}" BorderThickness="1">
                            <StackPanel>
                                <Border Height="104" CornerRadius="8" ClipToBounds="True"
                                        Background="{StaticResource WindowBrush}">
                                    <Image Source="{Binding Thumbnail}" Height="104" Width="244"
                                           Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           Margin="2,4,0,2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DetailText}" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="2,0,0,3" TextTrimming="CharacterEllipsis" />
                                <WrapPanel>
                                    <Button Content="Set" Margin="0,0,4,3" Padding="7,4,7,4"
                                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{Binding FavoriteLabel}" Margin="0,0,4,3" Padding="7,4,7,4"
                                            Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Open" Margin="0,0,4,3" Padding="7,4,7,4"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Remove" Margin="0,0,4,3" Padding="7,4,7,4"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}" />
                                    <ComboBox Width="96" Height="24" Margin="0,0,4,3"
                                              ToolTip="Move to collection"
                                              ItemsSource="{Binding DataContext.MoveTargets, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                              SelectedItem="{Binding SelectedCollection, Mode=TwoWay}" />
                                    <Button Content="Move" Margin="0,0,4,3" Padding="7,4,7,4"
                                            Command="{Binding DataContext.MoveToCollectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Padding="20" CornerRadius="12" Background="{StaticResource PanelBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="740"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" MaxWidth="700" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
