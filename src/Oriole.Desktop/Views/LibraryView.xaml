<UserControl x:Class="Oriole.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="Search library" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="240" Height="34" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Favorites only" Margin="12,0,12,0" VerticalAlignment="Center"
                          Foreground="{StaticResource TextBrush}"
                          IsChecked="{Binding FavoritesOnly}" />
                <Button Content="Refresh" Padding="12,7,12,7"
                        IsEnabled="{Binding IsRefreshEnabled}"
                        Command="{Binding RefreshCommand}" />
            </WrapPanel>

            <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="Apply target" VerticalAlignment="Center" Margin="0,0,9,0" />
                <ComboBox Width="200" Height="34"
                          ItemsSource="{Binding Displays}"
                          SelectedItem="{Binding SelectedDisplay}"
                          DisplayMemberPath="DeviceName" />
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="264" Margin="0,0,12,12" Padding="9" CornerRadius="12"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource PanelAltBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Border Height="150" CornerRadius="8" ClipToBounds="True"
                                            Background="{StaticResource WindowBrush}">
                                        <Image Source="{Binding Thumbnail}" Height="150" Width="244"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               Margin="2,9,0,3" />
                                    <TextBlock Text="{Binding DetailText}" FontSize="10"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="2,0,0,8" />
                                    <WrapPanel>
                                        <Button Content="Set" Margin="0,0,5,5" Padding="9,6,9,6"
                                                Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{Binding FavoriteLabel}" Margin="0,0,5,5" Padding="9,6,9,6"
                                                Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Open file" Margin="0,0,5,5" Padding="9,6,9,6"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Remove" Margin="0,0,5,5" Padding="9,6,9,6"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Padding="20" CornerRadius="12" Background="{StaticResource PanelBrush}"
                        HorizontalAlignment="Left" MaxWidth="740">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" MaxWidth="700" />
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
