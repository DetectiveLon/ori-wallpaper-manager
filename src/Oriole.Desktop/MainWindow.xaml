<Window x:Class="Oriole.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oriole" Height="780" Width="1240" MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="18,22">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,3,0,34">
                        <Border Width="34" Height="34" CornerRadius="11" Background="#9ABEFF" VerticalAlignment="Center">
                            <TextBlock Text="O" Foreground="#101722" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ORIOLE" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="WALLPAPER STUDIO" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="11,0,0,9" />
                    <Button x:Name="OverviewNav" Style="{StaticResource NavButtonStyle}" Content="  Overview" Tag="Overview" Click="Navigate" Background="#263344" Foreground="{StaticResource TextBrush}" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="  Discover" Tag="Discover" Click="Navigate" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="  My library" Tag="Library" Click="Navigate" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="  Displays" Tag="Displays" Click="Navigate" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="  Automation" Tag="Automation" Click="Navigate" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#2A3442" Margin="6,12,6,16" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="  Settings" Tag="Settings" Click="Navigate" />
                    <TextBlock Text="BUILD 0.1.0 · PREVIEW" FontSize="9" Foreground="#738195" Margin="12,15,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="36,28,36,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,26">
                <TextBlock x:Name="PageTitle" Text="Your desktop, in order." FontSize="29" FontWeight="SemiBold" />
                <TextBlock x:Name="PageSubtitle" Text="Choose what you want to see. Or let Oriole take care of the rotation." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PageBody">
                    <Border Background="#202D3D" CornerRadius="18" Padding="26" Margin="0,0,0,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" MaxWidth="600">
                                <TextBlock Text="A calmer way to change your wallpaper." FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Find high-resolution images, shape your own collections, and give every display its own setup. No live wallpapers. No unnecessary background activity." FontSize="13" Foreground="#B7C6D8" TextWrapping="Wrap" Margin="0,11,0,18" />
                                <Button Content="Explore wallpapers" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Tag="Discover" Click="Navigate" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="174" Height="132" CornerRadius="13" Background="#31445B" Margin="24,0,0,0">
                                <Grid>
                                    <Ellipse Width="90" Height="90" Fill="#7897B8" Opacity="0.45" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="15,0,0,10" />
                                    <Ellipse Width="62" Height="62" Fill="#B7D1EE" Opacity="0.55" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,18,0" />
                                    <Rectangle Width="174" Height="40" Fill="#1B2938" VerticalAlignment="Bottom" Opacity="0.65" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="GET STARTED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,11" />
                    <UniformGrid Columns="2" Rows="2">
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="19" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="01  ·  DISCOVER" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                <TextBlock Text="Find your next wallpaper" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,6" />
                                <TextBlock Text="Search by tags, category, resolution, orientation, colour and popularity." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="19" Margin="10,0,0,10">
                            <StackPanel>
                                <TextBlock Text="02  ·  LIBRARY" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                <TextBlock Text="Keep the good ones" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,6" />
                                <TextBlock Text="Save images, organise them into collections, and use them offline." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="19" Margin="0,10,10,0">
                            <StackPanel>
                                <TextBlock Text="03  ·  DISPLAYS" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                <TextBlock Text="Set up every screen" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,6" />
                                <TextBlock Text="Assign different images and fitting rules to each connected monitor." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="19" Margin="10,10,0,0">
                            <StackPanel>
                                <TextBlock Text="04  ·  AUTOMATION" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                <TextBlock Text="Rotate on your terms" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,6" />
                                <TextBlock Text="Set a clear interval, see the next change, pause when gaming, and skip or replay any time." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Background="#18212C" CornerRadius="12" Padding="14" Margin="0,22,0,0">
                        <TextBlock Text="Preview build. Discovery, local library, per-display rotation and full-screen pause are implemented; schedules are session-only and there is no installer yet." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
