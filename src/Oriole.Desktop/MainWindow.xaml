<Window x:Class="Oriole.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Oriole" Height="640" Width="1240" MinHeight="600" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        WindowStyle="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: app mark + drag region + caption buttons. -->
        <Border Grid.Row="0"
                Background="{StaticResource TitleBarBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="O" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource OnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ORIOLE" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="WALLPAPER STUDIO" Style="{StaticResource CaptionTextStyle}"
                                   FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Empty middle column is the drag region. -->
                <Grid Grid.Column="1" Background="Transparent" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch"
                            HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" AutomationProperties.Name="Minimize" ToolTip="Minimize (Alt+M)"
                            KeyboardNavigation.TabIndex="0"
                            Style="{StaticResource WindowButtonStyle}" Click="OnMinimizeClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons"
                                   FontSize="{StaticResource WindowGlyphSize}"
                                   Foreground="{StaticResource WindowButtonForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="MaximizeButton" AutomationProperties.Name="Maximize" ToolTip="Maximize / Restore (Alt+R)"
                            KeyboardNavigation.TabIndex="1"
                            Style="{StaticResource WindowButtonStyle}" Click="OnMaximizeClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   FontSize="{StaticResource WindowGlyphSize}"
                                   Foreground="{StaticResource WindowButtonForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button x:Name="CloseButton" AutomationProperties.Name="Close" ToolTip="Close (Alt+C)"
                            KeyboardNavigation.TabIndex="2"
                            Style="{StaticResource CloseWindowButtonStyle}" Click="OnCloseClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons"
                                   FontSize="{StaticResource WindowGlyphSize}"
                                   Foreground="{StaticResource WindowButtonForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: navigation rail + page host. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True" Margin="0,18,0,16">
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,0">
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="6,4,6,14" />
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Settings" Click="Navigate"
                                KeyboardNavigation.TabIndex="7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons"
                                           FontSize="{StaticResource GlyphSize}" Width="22" TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="ORIOLE · v0.1 LOCAL" Style="{StaticResource CaptionTextStyle}"
                                   Margin="12,16,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Margin="14,0,14,0">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource EyebrowTextStyle}" Margin="12,6,0,14" />
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Discover" Click="Navigate"
                                KeyboardNavigation.TabIndex="3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons"
                                           FontSize="{StaticResource GlyphSize}" Width="22" TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Discover" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Library" Click="Navigate"
                                KeyboardNavigation.TabIndex="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons"
                                           FontSize="{StaticResource GlyphSize}" Width="22" TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="My library" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Displays" Click="Navigate"
                                KeyboardNavigation.TabIndex="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons"
                                           FontSize="{StaticResource GlyphSize}" Width="22" TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Displays" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Automation" Click="Navigate"
                                KeyboardNavigation.TabIndex="6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B3;" FontFamily="Segoe Fluent Icons"
                                           FontSize="{StaticResource GlyphSize}" Width="22" TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Automation" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="{StaticResource ContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,26">
                    <TextBlock x:Name="PageTitle" Text="{Binding Title}" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock x:Name="PageSubtitle" Text="{Binding Subtitle}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="PageBody" Content="{Binding CurrentView}" Margin="0" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
